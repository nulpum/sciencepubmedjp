---
// アフィリエイトリンクを ボタンで表示する共通コンポーネント
//
// 2026-11-23 改修: 旧実装は amazonLinks[0] を primary にして「Amazon検索」(keyword)
//   を全 variant で表示、Prime Student / Kindle Unlimited は bottom の chip 落ち
//   だった。GA4 で amazon_link_click が 28日 0件、Moshimo の 361 clicks も bot 扱い
//   と判明したため、CV に直結する Amazon 無料体験 2種 を top/mid の primary 2列に
//   昇格し、記事冒頭から読者に露出する構成に変更。
//
// 使い方 (article slug ページから):
//   <AffiliateButtons links={post.data.affiliate_links} variant="top" lang="ja" />
//
// variant:
//   top    - 記事冒頭 (無料体験 2つ の primary CTA)
//   mid    - 記事中盤 (本文と原典の間)
//   bottom - 記事末尾 (フル開示 + 補助リンク chip)

interface Props {
  links: { title: string; url: string }[];
  variant: 'top' | 'mid' | 'bottom';
  lang?: 'ja' | 'en';
}

const { links, variant, lang = 'ja' } = Astro.props as Props;

// URL パターンマッチで 用途別に分類
function isPrimeStudent(l: { url: string }) { return l.url.includes('amazonprime/student'); }
function isKindleUnlimited(l: { url: string }) {
  return l.url.includes('kindle') || (l.url.includes('amazon') && l.url.includes('digital-text'));
}
function isRakuten(l: { url: string }) {
  return l.url.includes('af.moshimo.com') || l.url.includes('rakuten.co.jp');
}
function isAmazonSearch(l: { url: string }) {
  return l.url.includes('amazon.co.jp/s') && !isKindleUnlimited(l);
}

const primeStudent = links.find(isPrimeStudent);
const kindleUnlimited = links.find(isKindleUnlimited);
const amazonSearches = links.filter(isAmazonSearch);
const rakutens = links.filter(isRakuten);

// Primary 2 枠: Prime Student + Kindle Unlimited を 最優先、それらが欠けている
// 記事 (9本の例外) では従来通り Amazon検索 + 楽天 で埋める
const primaries: { title: string; url: string; label: string; kind: 'amazon' | 'rakuten' }[] = [];
if (primeStudent) {
  primaries.push({
    title: primeStudent.title,
    url: primeStudent.url,
    label: lang === 'ja' ? '🎓 Prime Student 6ヶ月無料' : '🎓 Prime Student 6-Month Free Trial',
    kind: 'amazon',
  });
}
if (kindleUnlimited) {
  primaries.push({
    title: kindleUnlimited.title,
    url: kindleUnlimited.url,
    label: lang === 'ja' ? '📚 Kindle Unlimited 読み放題' : '📚 Kindle Unlimited',
    kind: 'amazon',
  });
}
// Prime Student が無い記事はフォールバック: Amazon検索 + 楽天
if (primaries.length === 0) {
  if (amazonSearches[0]) {
    primaries.push({
      title: amazonSearches[0].title,
      url: amazonSearches[0].url,
      label: lang === 'ja' ? '🛒 Amazon で探す' : '🛒 Search on Amazon',
      kind: 'amazon',
    });
  }
  if (rakutens[0]) {
    primaries.push({
      title: rakutens[0].title,
      url: rakutens[0].url,
      label: lang === 'ja' ? '📕 楽天で探す' : '📕 Search on Rakuten',
      kind: 'rakuten',
    });
  }
}
// Kindle Unlimited しか無く Prime Student 無しの場合、2枠目を Amazon検索で埋める
if (primaries.length === 1 && primeStudent === undefined && amazonSearches[0]) {
  primaries.push({
    title: amazonSearches[0].title,
    url: amazonSearches[0].url,
    label: lang === 'ja' ? '🛒 Amazon で探す' : '🛒 Search on Amazon',
    kind: 'amazon',
  });
}
if (primaries.length === 1 && kindleUnlimited === undefined && amazonSearches[0]) {
  primaries.push({
    title: amazonSearches[0].title,
    url: amazonSearches[0].url,
    label: lang === 'ja' ? '🛒 Amazon で探す' : '🛒 Search on Amazon',
    kind: 'amazon',
  });
}

// bottom variant の chip: primary 以外の全リンク (重複除外)
const primaryUrls = new Set(primaries.map((p) => p.url));
const extras = links.filter((l) => !primaryUrls.has(l.url));

// variant 別の見出し
const labels = {
  ja: {
    top: { emoji: '🎁', title: '学生限定 無料体験が使えます', sub: '読書で論文理解を深めるなら:' },
    mid: { emoji: '📖', title: '読み方を広げる無料体験', sub: 'ここまで読んで気になったら:' },
    bottom: { emoji: '🔍', title: 'この研究を掘り下げる', sub: 'Amazon の学生向け無料体験と関連書籍で深く学べます:' },
  },
  en: {
    top: { emoji: '🎁', title: 'Free trials for students', sub: 'Extend your reading with:' },
    mid: { emoji: '📖', title: 'Broaden with a free trial', sub: 'If this interests you:' },
    bottom: { emoji: '🔍', title: 'Explore this topic further', sub: 'Amazon student trials and related books:' },
  },
};
const t = labels[lang][variant];
const disclosureShort = lang === 'ja' ? '#PR / アフィリエイトリンク' : '#PR / affiliate links';
const disclosureFull = lang === 'ja'
  ? '#PR / 本サイトは Amazon アソシエイトおよび もしもアフィリエイト経由の楽天ブックスに参加しており、リンク経由の購入または無料体験登録で紹介料を受け取ることがあります (ユーザーの支払いは変わりません)'
  : '#PR / This site participates in Amazon Associates and Rakuten Books (via Moshimo Affiliate). Purchases or free-trial signups via these links may earn us a small commission at no extra cost to you.';
---
{primaries.length > 0 && (
  <aside class={`aff-cta aff-cta--${variant}`}>
    <p class="aff-cta__label">{t.emoji} {t.title}</p>
    <p class="aff-cta__sub">{t.sub}</p>
    <div class="aff-cta__buttons">
      {primaries.map((p) => (
        <a
          href={p.url}
          rel="sponsored noopener"
          target="_blank"
          class={`aff-cta__btn aff-cta__btn--${p.kind}`}
          data-affiliate={p.kind}
          data-variant={variant}
        >
          <span class="aff-cta__btn-text">{p.label}</span>
          <span class="aff-cta__btn-arrow">→</span>
        </a>
      ))}
    </div>
    {variant === 'bottom' && extras.length > 0 && (
      <div class="aff-cta__extras">
        <p class="aff-cta__extras-label">{lang === 'ja' ? '↓ 他のおすすめリンク:' : '↓ Other related links:'}</p>
        <div class="aff-cta__chips">
          {extras.map((link) => {
            const isAmz = link.url.includes('amazon');
            return (
              <a
                href={link.url}
                rel="sponsored noopener"
                target="_blank"
                class={`aff-cta__chip ${isAmz ? 'aff-cta__chip--amazon' : 'aff-cta__chip--rakuten'}`}
                data-affiliate={isAmz ? 'amazon-extra' : 'rakuten-extra'}
              >
                {link.title}
              </a>
            );
          })}
        </div>
      </div>
    )}
    <p class="aff-cta__note">{variant === 'bottom' ? disclosureFull : disclosureShort}</p>
  </aside>
)}

<style>
  .aff-cta {
    margin: 24px 0;
    padding: 18px 20px;
    background: linear-gradient(180deg, #fff8ea 0%, #fef4d8 100%);
    border: 1px solid #f0d78a;
    border-radius: 10px;
  }
  .aff-cta--top { margin: 20px 0 28px; }
  .aff-cta--mid { margin: 30px 0; background: linear-gradient(180deg, #f0f7ec 0%, #e5f2df 100%); border-color: #b5d4a3; }
  .aff-cta--bottom { margin: 32px 0 24px; }

  .aff-cta__label {
    font-weight: 700;
    color: #7a5a1e;
    margin: 0 0 4px;
    font-size: 1rem;
  }
  .aff-cta--mid .aff-cta__label { color: #2e6320; }

  .aff-cta__sub {
    margin: 4px 0 12px;
    color: #665038;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .aff-cta--mid .aff-cta__sub { color: #4a7040; }

  .aff-cta__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 10px 0 10px;
  }
  @media (max-width: 480px) {
    .aff-cta__buttons { grid-template-columns: 1fr; }
  }

  .aff-cta__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    color: white !important;
    transition: transform 0.12s, box-shadow 0.12s, filter 0.12s;
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.12);
  }
  .aff-cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 rgba(0, 0, 0, 0.12);
    filter: brightness(1.05);
  }
  .aff-cta__btn:active {
    transform: translateY(0);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.12);
  }
  .aff-cta__btn-text { flex: 1; }
  .aff-cta__btn-arrow { font-size: 1.15rem; margin-left: 6px; }

  .aff-cta__btn--amazon {
    background: linear-gradient(180deg, #ff9900 0%, #e88b00 100%);
    border: 1px solid #cc7a00;
  }
  .aff-cta__btn--rakuten {
    background: linear-gradient(180deg, #bf0000 0%, #a30000 100%);
    border: 1px solid #8a0000;
  }

  .aff-cta__note {
    font-size: 0.75rem;
    color: #8a7448;
    margin: 10px 0 0;
    line-height: 1.5;
  }
  .aff-cta--mid .aff-cta__note { color: #6d8060; }

  .aff-cta__extras {
    margin: 14px 0 4px;
    padding-top: 12px;
    border-top: 1px dashed rgba(122, 90, 30, 0.25);
  }
  .aff-cta__extras-label {
    font-size: 0.78rem;
    color: #7a5a1e;
    margin: 0 0 8px;
    font-weight: 600;
  }
  .aff-cta__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .aff-cta__chip {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.12s, filter 0.12s;
    line-height: 1.3;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .aff-cta__chip:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
    text-decoration: none;
  }
  .aff-cta__chip--amazon {
    background: #fff2d8;
    color: #a26a00 !important;
    border: 1px solid #f0d78a;
  }
  .aff-cta__chip--rakuten {
    background: #fde8e8;
    color: #a30000 !important;
    border: 1px solid #f0b8b8;
  }
  @media (max-width: 480px) {
    .aff-cta__chip { font-size: 0.78rem; padding: 6px 10px; max-width: calc(100% - 10px); }
  }
</style>
