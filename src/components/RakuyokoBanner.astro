---
import { pickRakuyokoBanner } from '../config/rakuyoko-banners';

export interface Props {
  slug: string;
  category?: string;
}

const { slug, category } = Astro.props;
const banner = pickRakuyokoBanner(slug, category);
---
{banner && (
  <div class="rakuyoko-banner" data-banner-id={banner.id}>
    <div class="rb-header">
      <span class="rb-badge">PR</span>
      <strong class="rb-title">{banner.title}</strong>
    </div>
    {banner.description && <p class="rb-desc">{banner.description}</p>}
    <a
      href={banner.url}
      class="rb-cta"
      target="_blank"
      rel="nofollow sponsored noopener"
      data-affiliate="rakuyoko"
    >
      楽天ラクヨコで見る →
    </a>
    <p class="rb-hint">楽天が運営するSNS風プチプラストア</p>
  </div>
)}

<style>
  .rakuyoko-banner {
    padding: 1.1rem 1.2rem;
    background: linear-gradient(135deg, #fff8f8 0%, #ffe8e8 100%);
    border: 1px solid #ffb6b6;
    border-radius: 8px;
    text-align: center;
    margin: 1.5rem 0;
  }
  .rb-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .rb-badge {
    background: #c62828;
    color: white;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.05em;
  }
  .rb-title {
    color: #c62828;
    font-size: 1rem;
  }
  .rb-desc {
    color: #555;
    font-size: 0.9rem;
    margin: 0.3rem 0 0.7rem;
  }
  .rb-cta {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: #c62828;
    color: white !important;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 0.95rem;
  }
  .rb-cta:hover {
    background: #a01f1f;
    text-decoration: none;
  }
  .rb-hint {
    font-size: 0.72rem;
    color: #888;
    margin: 0.5rem 0 0;
  }
</style>
