---
import { pickRakuyokoBanner } from '../config/rakuyoko-banners';

export interface Props {
  slug: string;
  category?: string;
  lang?: 'ja' | 'en';
}

const { slug, category, lang = 'ja' } = Astro.props;
const banner = pickRakuyokoBanner(slug, category);

// EN 向けは 英語書籍 中心 の Kindle Unlimited JP に 差し替え
// (JP 在住 の 英語論文 読み 学生 / 研究者 を 想定、 Amazon JP tag が 使える)
const EN_BANNER = {
  id: 'ku-en',
  title: 'Kindle Unlimited',
  description: 'Unlimited access to thousands of English academic books & journals (Amazon Japan)',
  url: 'https://www.amazon.co.jp/kindle-dbs/hz/signup?tag=sciencepubm06-22&language=en_US',
};

const b = lang === 'en' ? EN_BANNER : banner;
const cta = lang === 'en' ? 'Try Kindle Unlimited →' : 'Prime Student を試す →';
const hint = lang === 'en'
  ? 'Free 30-day trial · Available via Amazon Japan'
  : '大学生・院生・専門学生なら 6ヶ月無料';
---
{b && (
  <div class="rakuyoko-banner" data-banner-id={b.id}>
    <div class="rb-header">
      <span class="rb-badge">{lang === 'en' ? 'Sponsored' : 'PR'}</span>
      <strong class="rb-title">{b.title}</strong>
    </div>
    {b.description && <p class="rb-desc">{b.description}</p>}
    <a
      href={b.url}
      class="rb-cta"
      target="_blank"
      rel="nofollow sponsored noopener"
      data-affiliate={lang === 'en' ? 'kindle-unlimited' : 'rakuyoko'}
    >
      {cta}
    </a>
    <p class="rb-hint">{hint}</p>
  </div>
)}

<style>
  .rakuyoko-banner {
    padding: 1.1rem 1.2rem;
    background: linear-gradient(135deg, #fff8ec 0%, #ffe8c8 100%);
    border: 1px solid #ffb84d;
    border-radius: 8px;
    text-align: center;
    margin: 1.5rem 0;
  }
  .rb-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .rb-badge {
    background: #f0820b;
    color: white;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.05em;
  }
  .rb-title {
    color: #c25f00;
    font-size: 1rem;
  }
  .rb-desc {
    color: #555;
    font-size: 0.9rem;
    margin: 0.3rem 0 0.7rem;
  }
  .rb-cta {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: #f0820b;
    color: white !important;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 0.95rem;
  }
  .rb-cta:hover {
    background: #cc6500;
    text-decoration: none;
  }
  .rb-hint {
    font-size: 0.72rem;
    color: #888;
    margin: 0.5rem 0 0;
  }
</style>
