---
// Career / 転職系 ASP の 高単価 CTA。
// ASP 審査通過 前 は placeholder として disabled 表示 し、 click を飛ばさない。
// URL 入手 後 config/career-ctas.ts の url と placeholder: false に 差し替え 。

import { CAREER_CTAS, pickCareerVariant } from '../config/career-ctas';
import type { CareerVariant } from '../config/career-ctas';

export interface Props {
  category?: string;
  tags?: string[];
  slug?: string;
  lang?: 'ja' | 'en';
  forceVariant?: CareerVariant;
}

const { category, tags, slug, lang = 'ja', forceVariant } = Astro.props;
const variant = forceVariant || pickCareerVariant({ category, tags, slug, lang });
const cta = variant ? CAREER_CTAS[variant] : null;

// placeholder (ASP 審査中 で URL 未入手) の 間 は 本番 非表示。
// ローカル確認用 に CAREER_CTA_PREVIEW=true で 強制 表示 可能。
const previewMode = process.env.CAREER_CTA_PREVIEW === 'true';
const shouldRender = cta && (!cta.placeholder || previewMode);
---
{shouldRender && cta && (
  <aside
    class={`career-cta career-cta--${cta.variant} ${cta.placeholder ? 'is-placeholder' : ''}`}
    data-variant={cta.variant}
    data-placeholder={cta.placeholder ? '1' : '0'}
    aria-label={cta.title}
  >
    <div class="career-cta__head">
      <span class="career-cta__badge">PR</span>
      <h3 class="career-cta__title">{cta.title}</h3>
    </div>
    <p class="career-cta__desc">{cta.description}</p>
    <ul class="career-cta__bullets">
      {cta.bullets.map(b => <li>{b}</li>)}
    </ul>
    {cta.placeholder ? (
      <button type="button" class="career-cta__btn is-disabled" disabled>
        {cta.ctaLabel}
      </button>
    ) : (
      <a
        href={cta.url}
        class="career-cta__btn"
        target="_blank"
        rel="sponsored noopener"
        data-affiliate={`career-${cta.variant}`}
      >
        {cta.ctaLabel}
      </a>
    )}
    <p class="career-cta__note">
      {cta.disclosureShort} · 提供: {cta.provider}
    </p>
  </aside>
)}

<style>
  .career-cta {
    margin: 2rem 0;
    padding: 1.2rem 1.4rem;
    background: linear-gradient(180deg, #f0f7ff 0%, #e4edfa 100%);
    border: 1px solid #a8c4e8;
    border-radius: 10px;
  }
  .career-cta--nurse       { background: linear-gradient(180deg, #ffeef2 0%, #ffd9e2 100%); border-color: #f5a0b4; }
  .career-cta--doctor      { background: linear-gradient(180deg, #e8f5f0 0%, #d0e8dd 100%); border-color: #92c4a8; }
  .career-cta--pharmacist  { background: linear-gradient(180deg, #fff6e5 0%, #ffe8c0 100%); border-color: #e8b870; }
  .career-cta--researcher  { background: linear-gradient(180deg, #f3eaff 0%, #e2d0f8 100%); border-color: #b5a0d8; }

  .career-cta__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .career-cta__badge {
    background: #d04040;
    color: white;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.05em;
  }
  .career-cta__title {
    margin: 0;
    font-size: 1.1rem;
    color: #1a3550;
  }
  .career-cta__desc {
    margin: 0.4rem 0 0.8rem;
    color: #333;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .career-cta__bullets {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: #444;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .career-cta__bullets li { margin: 0.2rem 0; }

  .career-cta__btn {
    display: inline-block;
    padding: 0.75rem 1.6rem;
    background: #d04040;
    color: white !important;
    text-decoration: none;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s, filter 0.12s;
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.12);
  }
  .career-cta__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    text-decoration: none;
  }
  .career-cta__btn.is-disabled {
    background: #bbb;
    color: #666 !important;
    cursor: not-allowed;
    box-shadow: none;
  }
  .career-cta__btn.is-disabled:hover {
    transform: none;
    filter: none;
  }

  .is-placeholder {
    opacity: 0.6;
    position: relative;
  }
  .is-placeholder::after {
    content: "⚠ ASP 審査中 (運営用)";
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    background: #333;
    color: white;
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .career-cta__note {
    font-size: 0.72rem;
    color: #777;
    margin: 0.7rem 0 0;
  }
</style>
