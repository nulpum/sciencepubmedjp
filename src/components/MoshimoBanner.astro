---
// もしもアフィリエイト バナー広告 (config 駆動、N 種ランダム表示)
//
// バナーの追加は src/config/moshimo-banners.ts の MOSHIMO_BANNERS 配列に entry 追加のみ。
//
// multi-instance 対応:
//   - guard flag で script は 1 度だけ実行
//   - DOMContentLoaded で全 [data-moshimo-slot] を fill
//   - dataset.filled で二重挿入防止
//   - 各 slot が独立にランダムな banner を表示

import { MOSHIMO_BANNERS } from '../config/moshimo-banners';

// impression pixel の loading="lazy" を除去する。
// 1x1 px の tracking pixel は lazy loading だとブラウザが viewport 判定に迷って
// 発火しない (特にモバイル)。結果、Moshimo 側で impression 大幅未カウント →
// CTR 異常高く見える問題が起きる。tracking pixel は eager 前提で発火させる。
function stripLazyFromImpression(html: string): string {
  return html.replace(
    /(<img[^>]*i\.moshimo\.com\/af\/i\/impression[^>]*?)\s+loading="lazy"/g,
    '$1',
  );
}

// SSR 段階で JS 文字列として渡す (client 側で JSON.parse)
const bannersJson = JSON.stringify(
  MOSHIMO_BANNERS.map((b) => ({ id: b.id, html: stripLazyFromImpression(b.html) })),
);
---
<aside class="moshimo-banner" aria-label="スポンサー広告">
  <p class="moshimo-banner__label">📖 スポンサー</p>
  <div class="moshimo-banner__slot" data-moshimo-slot>
    <!-- client-side で banner を挿入 -->
  </div>
  <p class="moshimo-banner__note">#PR / もしもアフィリエイト経由</p>
</aside>

<script is:inline set:html={`
  (function () {
    if (window.__moshimoBannerInit) return;
    window.__moshimoBannerInit = true;
    var BANNERS = ${bannersJson};
    if (!Array.isArray(BANNERS) || BANNERS.length === 0) return;
    function fillSlots() {
      var slots = document.querySelectorAll('[data-moshimo-slot]');
      slots.forEach(function (slot) {
        if (slot.dataset.filled) return;
        slot.dataset.filled = '1';
        var idx = Math.floor(Math.random() * BANNERS.length);
        var b = BANNERS[idx];
        slot.innerHTML = b.html;
        if (typeof gtag === 'function') {
          gtag('event', 'moshimo_banner_impression', { banner_id: b.id, banner_index: idx });
        }
        // クリック計測: slot 内の a タグ (affiliate リンク) に発火 listener を付ける。
        // target="_blank" なので現ページは残る → beacon で確実に送信できる。
        var links = slot.querySelectorAll('a[href*="af.moshimo.com"]');
        links.forEach(function (link) {
          link.addEventListener('click', function () {
            if (typeof gtag === 'function') {
              gtag('event', 'moshimo_banner_click', {
                banner_id: b.id,
                banner_index: idx,
                transport_type: 'beacon',
              });
            }
          });
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fillSlots);
    } else {
      fillSlots();
    }
  })();
`} />

<style>
  .moshimo-banner {
    max-width: 720px;
    margin: 16px auto;
    padding: 12px 14px;
    background: #fafafa;
    border: 1px dashed var(--border);
    border-radius: 10px;
    text-align: center;
  }
  .moshimo-banner__label {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    margin: 0 0 8px;
    text-transform: uppercase;
    font-weight: 600;
  }
  .moshimo-banner__slot { min-height: 250px; display: flex; align-items: center; justify-content: center; }
  .moshimo-banner__slot img { max-width: 100%; height: auto; }
  .moshimo-banner__note {
    font-size: 0.7rem;
    color: var(--muted);
    margin: 8px 0 0;
  }
</style>
