---
// もしもアフィリエイト バナー広告 (3 種ローテーション)
//
// 1 ページアクセスごとに client-side でランダムに 1 個表示。
// impression pixel は表示された banner のみ発火 (未表示のは Fire しない = 適正)。
//
// 追加する場合: BANNERS 配列に HTML を string で足す。
//
// 配置: JA 記事下部 (RakutenMotionWidget の直下 or AdUnit の直上)。
---
<aside class="moshimo-banner" aria-label="スポンサー広告">
  <p class="moshimo-banner__label">📖 スポンサー</p>
  <div class="moshimo-banner__slot" data-moshimo-slot>
    <!-- client-side で 1 個ランダム挿入される -->
  </div>
  <p class="moshimo-banner__note">#PR / もしもアフィリエイト経由</p>
</aside>

<script is:inline>
  (function () {
    // 3 banner の HTML (実際の HTML を string リテラルで持つ)
    var BANNERS = [
      '<a href="//af.moshimo.com/af/c/click?a_id=5800909&p_id=5144&pc_id=13942&pl_id=67749" rel="nofollow sponsored noopener" referrerpolicy="no-referrer-when-downgrade" target="_blank"><img src="//image.moshimo.com/af-img/4800/000000067749.jpg" width="1404" height="180" style="border:none;max-width:100%;height:auto;display:block;margin:0 auto;" alt="広告"></a><img src="//i.moshimo.com/af/i/impression?a_id=5800909&p_id=5144&pc_id=13942&pl_id=67749" width="1" height="1" style="border:none;" loading="lazy" alt="">',
      '<a href="//af.moshimo.com/af/c/click?a_id=5800874&p_id=2826&pc_id=6435&pl_id=71612" rel="nofollow sponsored noopener" referrerpolicy="no-referrer-when-downgrade" target="_blank"><img src="//image.moshimo.com/af-img/2083/000000071612.png" width="550" height="152" style="border:none;max-width:100%;height:auto;display:block;margin:0 auto;" alt="広告"></a><img src="//i.moshimo.com/af/i/impression?a_id=5800874&p_id=2826&pc_id=6435&pl_id=71612" width="1" height="1" style="border:none;" loading="lazy" alt="">',
      '<a href="//af.moshimo.com/af/c/click?a_id=5800868&p_id=1166&pc_id=1793&pl_id=17969" rel="nofollow sponsored noopener" referrerpolicy="no-referrer-when-downgrade" target="_blank"><img src="//image.moshimo.com/af-img/0408/000000017969.png" width="300" height="300" style="border:none;max-width:100%;height:auto;display:block;margin:0 auto;" alt="広告"></a><img src="//i.moshimo.com/af/i/impression?a_id=5800868&p_id=1166&pc_id=1793&pl_id=17969" width="1" height="1" style="border:none;" loading="lazy" alt="">'
    ];
    var slot = document.querySelector('[data-moshimo-slot]');
    if (slot) {
      var idx = Math.floor(Math.random() * BANNERS.length);
      slot.innerHTML = BANNERS[idx];
      // GA イベント (発火統計)
      if (typeof gtag === 'function') {
        gtag('event', 'moshimo_banner_impression', { banner_index: idx });
      }
    }
  })();
</script>

<style>
  .moshimo-banner {
    max-width: 720px;
    margin: 24px auto;
    padding: 16px 18px;
    background: #fafafa;
    border: 1px dashed var(--border);
    border-radius: 10px;
    text-align: center;
  }
  .moshimo-banner__label {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    margin: 0 0 8px;
    text-transform: uppercase;
    font-weight: 600;
  }
  .moshimo-banner__slot {
    min-height: 100px;
  }
  .moshimo-banner__slot img {
    max-width: 100%;
    height: auto;
  }
  .moshimo-banner__note {
    font-size: 0.72rem;
    color: var(--muted);
    margin: 10px 0 0;
  }
</style>
