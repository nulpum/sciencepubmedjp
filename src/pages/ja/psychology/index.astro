---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('ja_psychology')).sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);
---
<BaseLayout title="心理学トリビア | PubMed Trivia" lang="ja">
  <h1>心理学トリビア</h1>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/ja/psychology/${post.id}/`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
