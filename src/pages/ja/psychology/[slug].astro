---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('ja_psychology');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);

// 同カテゴリの他記事から最新 3 件 (current 除く)
const related = (all as typeof post[])
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at))
  .slice(0, 3);

const ogImage = `/og/ja/${post.id}.png`;
---
<BaseLayout title={post.data.title} description={post.data.fact} lang="ja" ogType="article" ogImage={ogImage}>
  <article>
    <h1>{post.data.title}</h1>
    <p><strong>{post.data.fact}</strong></p>
    <Content />
    <hr />
    <p>
      原典: <a href={post.data.source_url} rel="noopener" target="_blank">PMID {post.data.pmid}</a>
      {post.data.journal && <span>（{post.data.journal}{post.data.year && `, ${post.data.year}`}）</span>}
    </p>
    {post.data.affiliate_links && post.data.affiliate_links.length > 0 && (
      <section>
        <h2>関連書籍 #PR</h2>
        <ul>
          {post.data.affiliate_links.map((l) => (
            <li><a href={l.url} rel="sponsored noopener" target="_blank">{l.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="related-section">
      <h2>他の心理学トリビア</h2>
      <ul class="card-grid">
        {related.map((p) => (
          <li class="card">
            <a href={`/ja/psychology/${p.id}/`}>{p.data.title}</a>
            <p class="card__fact">{p.data.fact}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
