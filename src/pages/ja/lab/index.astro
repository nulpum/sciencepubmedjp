---
// PubMed Lab トップ + 結果ページ (SSR)
// クエリパラメータ ?q=... で検索実行 → 結果表示
// クエリなしの場合は検索窓 + サンプルクエリ表示
//
// 2026-09 更新:
// - 論文カードに ⭐ 保存 + 💬 壁打ちチャット を追加 (β)
// - 保存は localStorage、壁打ちは Claude API 経由で /api/chat を叩く
// - GA4 に lab_search / lab_save_paper / lab_chat_open / lab_chat_message などを送信

import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdUnit from '../../../components/AdUnit.astro';
import { translateQueryToEnglish } from '../../../lib/query-translator';
import { searchPmids, fetchArticles, pubmedUrl } from '../../../lib/pubmed';
import { LAB_CONFIG, isWaitlistEnabled } from '../../../config/lab';

export const prerender = false;

function getEnv(locals: any, key: string): string | undefined {
  const cf = locals?.runtime?.env;
  if (cf && key in cf) return cf[key];
  return typeof process !== 'undefined' ? process.env[key] : undefined;
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim();

interface ResultItem {
  pmid: string;
  title: string;
  authors: string[];
  journal?: string;
  year?: number;
  abstract: string;
  url: string;
}

let englishQuery = '';
let translationNotes = '';
let results: ResultItem[] = [];
let totalCount = 0;
let elapsedMs = 0;
let errorMessage = '';

interface SiteMatch {
  slug: string;
  category: 'psychology' | 'biology';
  title: string;
  fact: string;
  url: string;
}
let siteMatches: SiteMatch[] = [];

if (q) {
  const startedAt = Date.now();
  try {
    const apiKey = (getEnv(Astro.locals, 'ANTHROPIC_API_KEY') || '').trim();
    if (!apiKey) throw new Error('サーバー設定エラー (API key 未設定)');
    const pubmedCfg = {
      tool: getEnv(Astro.locals, 'PUBMED_TOOL') || 'pubmed-trivia-lab',
      email: getEnv(Astro.locals, 'PUBMED_EMAIL') || 'sciencepubmedjp@gmail.com',
      apiKey: getEnv(Astro.locals, 'PUBMED_API_KEY') || undefined,
    };

    const translation = await translateQueryToEnglish(apiKey, q);
    englishQuery = translation.englishQuery;
    translationNotes = translation.notes || '';

    const { pmids, total } = await searchPmids(pubmedCfg, englishQuery, 10);
    totalCount = total;

    if (pmids.length > 0) {
      const articles = await fetchArticles(pubmedCfg, pmids);
      results = articles.map((a) => ({
        pmid: a.pmid,
        title: a.title,
        authors: a.authors.slice(0, 3),
        journal: a.journal,
        year: a.year,
        abstract: a.abstract,
        url: pubmedUrl(a.pmid),
      }));
    }
    elapsedMs = Date.now() - startedAt;

    try {
      const psy = await getCollection('ja_psychology');
      const bio = await getCollection('ja_biology');
      const all = [...psy, ...bio];
      const tokens = q
        .split(/[\s、,.。・]+/)
        .filter((t) => t.length >= 2);
      const scored = all
        .map((p) => {
          const haystack = (p.data.title + ' ' + p.data.fact).toLowerCase();
          let score = 0;
          for (const t of tokens) {
            if (haystack.includes(t.toLowerCase())) score++;
          }
          return { post: p, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 4);
      siteMatches = scored.map((x) => ({
        slug: x.post.id,
        category: x.post.data.category,
        title: x.post.data.title,
        fact: x.post.data.fact,
        url: `/ja/${x.post.data.category}/${x.post.id}/`,
      }));
    } catch { /* siteMatches は握りつぶし */ }
  } catch (e) {
    errorMessage = (e as Error).message || String(e);
  }
}

const sampleQueries = [
  '大学生の睡眠不足と学業成績の関係',
  'ADHD の子どもへの認知行動療法の効果',
  '腸内細菌と精神的健康 (メタアナリシス)',
  'HSP (Highly Sensitive Person) の科学的根拠',
  'マインドフルネスと不安症のシステマティックレビュー',
  '運動習慣と認知機能低下の予防',
  '発達心理学 最近のホット領域',
  '大学院進学のメリットと課題',
];

const pageTitle = q
  ? `検索: ${q} ｜ PubMed Lab`
  : 'PubMed Lab ｜ 日本語で論文を探せるリサーチアシスタント';
const pageDesc = q
  ? `「${q}」の PubMed 検索結果 (${totalCount} 件中 ${results.length} 件表示)`
  : '日本語で入力するだけで、PubMed の英語論文を検索できるツール。卒論・研究テーマ探しに。';

// waitlist URL は client 側 JS からも参照するため data 属性で渡す
const waitlistUrl = isWaitlistEnabled() ? LAB_CONFIG.waitlistUrl : '';
---
<BaseLayout title={pageTitle} description={pageDesc} lang="ja">
  <article class="lab" data-waitlist-url={waitlistUrl}>
    <header class="lab__header">
      <p class="lab__breadcrumb">
        <a href="/ja/">ホーム</a> › PubMed Lab
        <span class="lab__breadcrumb-links">
          <a href="/ja/lab/toolkit/" class="lab__toolkit-link">🤖 自分の AI で使う</a>
          <a href="/ja/lab/saved/" class="lab__saved-link">⭐ 保存した論文</a>
        </span>
      </p>
      <h1>🔬 PubMed Lab</h1>
      <p class="lab__lede">
        日本語で入力するだけで、PubMed の英語論文を検索できるリサーチアシスタントです。<br>
        卒論・研究テーマ探し、興味のある論文を効率よく見つけられます。
      </p>
    </header>

    <form method="GET" action="/ja/lab/" class="lab__form" id="lab-search-form">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="例: 大学生の睡眠不足と学業成績"
        class="lab__input"
        autofocus={!q}
        required
      />
      <button type="submit" class="lab__submit">検索する</button>
    </form>

    {!q && (
      <section class="lab__samples">
        <p class="lab__samples-title">💡 サンプル検索 (クリックで実行)</p>
        <ul class="lab__samples-list">
          {sampleQueries.map((sq) => (
            <li><a href={`/ja/lab/?q=${encodeURIComponent(sq)}`}>{sq}</a></li>
          ))}
        </ul>

        <section class="lab__howto">
          <h2>使い方</h2>
          <ol>
            <li>気になるテーマ・質問を <strong>日本語で</strong> 入力</li>
            <li>AI が英語の PubMed 検索クエリに変換</li>
            <li>マッチする論文を最大 10 件、英語 abstract 付きで表示</li>
            <li>気になった論文は ⭐ で <strong>保存</strong>、💬 で <strong>壁打ちチャット</strong> (β)</li>
          </ol>
        </section>

        <section class="lab__features">
          <h2>使える機能 (すべて無料・登録不要)</h2>
          <ul>
            <li>🔍 <strong>日本語→英語クエリ変換</strong>: MeSH タームも AI が判断</li>
            <li>⭐ <strong>お気に入り保存</strong>: この端末のブラウザに保存 (<a href="/ja/lab/saved/">一覧を見る</a>)</li>
            <li>💬 <strong>論文と壁打ちチャット (β)</strong>: 各論文の abstract を元に AI と質疑応答。 <em>1 日 3 メッセージまで / このブラウザ単位</em></li>
            <li>🎓 <strong>卒論・修論テーマ提案</strong>: 検索結果を AI が俯瞰して研究テーマ 3 案を提案 <em>(1 日 3 回)</em></li>
            <li>🤖 <strong>自分の ChatGPT / Claude / Gemini で使う</strong>: 論文専用プロンプトを無料配布 → 上限突破・完全無制限 (<a href="/ja/lab/toolkit/">プロンプトを取得 →</a>)</li>
            <li>📖 <strong>サイト内解説マッチ</strong>: 関連する日本語解説記事も同時表示</li>
          </ul>
          <p class="lab__features-note">
            ⚠️ 壁打ちチャットは実験β。 abstract 情報のみを根拠にしているため、フルテキスト精読の代わりにはなりません。医療助言もしません。
          </p>
        </section>

        {/* Lab トップページ AdSense (未検索状態の end-of-scroll ゾーン) */}
        <AdUnit slot="labTop" />

        {waitlistUrl && (
          <section class="lab__waitlist-cta">
            <div class="lab__waitlist-cta-body">
              <h2 class="lab__waitlist-cta-title">📱 iOS / Android アプリ 準備中!</h2>
              <p class="lab__waitlist-cta-desc">
                PubMed Lab を <strong>スマホアプリ</strong> でもリリース予定です。 卒論シーズンに向けて、リリース時にメールでお知らせします (メールのみ 1 分)。
              </p>
              <ul class="lab__waitlist-cta-benefits">
                <li>📱 iOS / Android 両対応 (完全無料版・広告付き)</li>
                <li>💬 移動中もサクッと論文検索・壁打ちができるように</li>
                <li>⏰ 卒論シーズン (11-12月) リリース目標</li>
              </ul>
            </div>
            <a
              href={waitlistUrl}
              class="lab__waitlist-cta-btn"
              target="_blank"
              rel="noopener"
              data-ga-event="lab_waitlist_click_default"
            >
              📧 リリース通知を受け取る →
            </a>
          </section>
        )}

        <section class="lab__disclaimer">
          <p>
            ⚠️ 本ツールは一般教養目的で、医療助言ではありません。研究結果の解釈にあたっては
            <a href="/ja/guide/how-to-read-research/">論文の読み方ガイド</a>
            もご参照ください。
          </p>
        </section>
      </section>
    )}

    {q && errorMessage && (
      <section class="lab__error">
        <p><strong>エラー:</strong> {errorMessage}</p>
        <p>時間をおいてもう一度お試しください。</p>
      </section>
    )}

    {q && !errorMessage && (
      <section class="lab__results">
        <div class="lab__meta">
          <p><strong>「{q}」</strong>の検索結果</p>
          <p class="lab__meta-detail">
            {totalCount.toLocaleString()} 件中 {results.length} 件を表示 ({elapsedMs} ms)
            <span class="lab__meta-sep">·</span>
            <a href="/ja/lab/saved/">⭐ 保存した論文</a>
          </p>
          {englishQuery && (
            <details class="lab__query-detail">
              <summary>AI が生成した英語クエリを見る</summary>
              <pre>{englishQuery}</pre>
              {translationNotes && <p class="lab__query-notes">💡 {translationNotes}</p>}
            </details>
          )}
        </div>

        {results.length > 0 && (
          <section class="theme-suggest" data-user-query={q}>
            <div class="theme-suggest__prompt">
              <div class="theme-suggest__prompt-body">
                <h2 class="theme-suggest__title">🎓 卒論・修論テーマを AI が提案</h2>
                <p class="theme-suggest__desc">
                  この {Math.min(results.length, 5)} 本の論文を俯瞰して、あなたが実際に卒論・修論で研究できるテーマを 3 つ提案します。
                </p>
              </div>
              <div class="theme-suggest__action">
                <button type="button" id="theme-suggest-btn" class="theme-suggest__btn">
                  ✨ 提案してもらう
                </button>
                <span class="theme-suggest__quota">
                  残り <span id="theme-quota-count">3</span> / 3 回 (今日)
                </span>
              </div>
            </div>
            <div id="theme-suggest-result" class="theme-suggest__result" hidden></div>
          </section>
        )}

        {siteMatches.length > 0 && (
          <section class="lab__site-matches">
            <h2 class="lab__site-matches-title">
              📖 このサイトの解説記事から (日本語で読める)
            </h2>
            <p class="lab__site-matches-note">
              PubMed Trivia が過去に取り上げた論文を日本語で解説している記事です。
            </p>
            <ul class="lab__site-cards">
              {siteMatches.map((m) => (
                <li class="lab__site-card">
                  <a href={m.url}>
                    <span class={`tag tag--${m.category}`}>
                      {m.category === 'psychology' ? '心理学' : '生物学'}
                    </span>
                    <strong>{m.title}</strong>
                    <span class="lab__site-card-fact">{m.fact}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {results.length === 0 && (
          <p class="lab__no-results">該当する論文が見つかりませんでした。別のキーワードでお試しください。</p>
        )}

        {results.length > 0 && (
          <h2 class="lab__results-title">🔍 PubMed の検索結果</h2>
        )}

        <ul class="lab__cards">
          {results.map((r) => {
            // client 側 JS で使う JSON: PaperContext + 保存用データ
            const paperJson = JSON.stringify({
              pmid: r.pmid,
              title: r.title,
              authors: r.authors,
              journal: r.journal,
              year: r.year,
              abstract: r.abstract,
              url: r.url,
            });
            return (
              <li class="lab__card" id={`pmid-${r.pmid}`} data-paper={paperJson}>
                <h2 class="lab__card-title">
                  <a href={r.url} rel="noopener" target="_blank">{r.title}</a>
                </h2>
                <p class="lab__card-meta">
                  {r.authors.length > 0 && <span>{r.authors.join(', ')}{r.authors.length >= 3 && ' 他'}</span>}
                  {r.journal && <span> · {r.journal}</span>}
                  {r.year && <span> · {r.year}</span>}
                </p>
                <p class="lab__card-abstract">
                  {r.abstract.length > 400 ? r.abstract.slice(0, 400) + '…' : r.abstract}
                </p>
                <div class="lab__card-actions">
                  <a href={r.url} rel="noopener" target="_blank" class="lab__card-link">
                    📄 PubMed で読む (PMID: {r.pmid})
                  </a>
                  <div class="lab__card-buttons">
                    <button type="button" class="lab__btn lab__btn--save" data-pmid={r.pmid}>
                      <span class="lab__btn-icon" aria-hidden="true">☆</span>
                      <span class="lab__btn-label">保存</span>
                    </button>
                    <button type="button" class="lab__btn lab__btn--chat" data-pmid={r.pmid}>
                      💬 <span class="lab__btn-label">この論文と壁打ち</span>
                    </button>
                  </div>
                </div>

                {/* 壁打ちチャット (デフォルト hidden) */}
                <div class="paper-chat" data-pmid={r.pmid} hidden>
                  <div class="paper-chat__head">
                    <span class="paper-chat__title">💬 論文と壁打ち β</span>
                    <span class="paper-chat__quota">残り <span class="quota-count">3</span> / 3 回 (今日)</span>
                  </div>
                  <div class="paper-chat__notice">
                    Abstract の内容だけを根拠に答えます。医療助言はしません。abstract に無い事実は「記載なし」と返します。
                  </div>
                  <div class="paper-chat__messages"></div>
                  <form class="paper-chat__form">
                    <input
                      type="text"
                      class="paper-chat__input"
                      placeholder="例: この研究の要点を3つ / 反対の結論の研究は? / 卒論引用向きの表現に"
                      maxlength="500"
                      required
                    />
                    <button type="submit" class="paper-chat__submit">送信</button>
                  </form>
                  <p class="paper-chat__hint">
                    質問例: 「要点を3つ教えて」「結論の限界は?」「N数と統計手法は?」「反論できる可能性は?」
                  </p>
                </div>
              </li>
            );
          })}
        </ul>

        <div class="lab__back">
          <a href="/ja/lab/">← 別のキーワードで検索する</a>
        </div>

        {/* Lab 検索結果ページ AdSense (waitlist CTA の直上) */}
        <AdUnit slot="labResults" />

        {waitlistUrl && (
          <aside class="lab__waitlist-cta lab__waitlist-cta--compact">
            <div class="lab__waitlist-cta-body">
              <h2 class="lab__waitlist-cta-title">📱 スマホアプリ準備中</h2>
              <p class="lab__waitlist-cta-desc">
                iOS / Android アプリ (無料版・広告付き) を卒論シーズンに向けてリリース予定。 メールで通知受け取りませんか?
              </p>
            </div>
            <a
              href={waitlistUrl}
              class="lab__waitlist-cta-btn"
              target="_blank"
              rel="noopener"
              data-ga-event="lab_waitlist_click_results"
            >
              📧 1 分で通知登録 →
            </a>
          </aside>
        )}
      </section>
    )}
  </article>

  {/* ==================== Client-side JS (inline, no bundling) ==================== */}
  {q && !errorMessage && results.length > 0 && (
    <script is:inline>
      (function() {
        const SAVE_KEY = 'pubmedlab_saved_v1';
        const QUOTA_KEY = 'pubmedlab_chat_quota_v1';
        const THEME_QUOTA_KEY = 'pubmedlab_theme_quota_v1';
        const DAILY_LIMIT = 3;
        const THEME_DAILY_LIMIT = 3;

        // ------------------ localStorage helpers ------------------
        function loadSaved() {
          try {
            const raw = localStorage.getItem(SAVE_KEY);
            const arr = raw ? JSON.parse(raw) : [];
            return Array.isArray(arr) ? arr : [];
          } catch { return []; }
        }
        function saveSaved(arr) {
          try { localStorage.setItem(SAVE_KEY, JSON.stringify(arr)); } catch {}
        }
        function isSaved(pmid) {
          return loadSaved().some((p) => p.pmid === pmid);
        }
        function toggleSaved(paper) {
          const arr = loadSaved();
          const idx = arr.findIndex((p) => p.pmid === paper.pmid);
          if (idx >= 0) {
            arr.splice(idx, 1);
            saveSaved(arr);
            return false;
          }
          arr.push({ ...paper, savedAt: new Date().toISOString() });
          saveSaved(arr);
          return true;
        }

        // ------------------ Quota (chat rate limit) ------------------
        function today() { return new Date().toISOString().slice(0, 10); }
        function readQuota() {
          try {
            const raw = localStorage.getItem(QUOTA_KEY);
            const obj = raw ? JSON.parse(raw) : {};
            if (obj.date !== today()) return { date: today(), count: 0 };
            return { date: obj.date, count: obj.count || 0 };
          } catch { return { date: today(), count: 0 }; }
        }
        function bumpQuota() {
          const q = readQuota();
          q.count += 1;
          try { localStorage.setItem(QUOTA_KEY, JSON.stringify(q)); } catch {}
          return q;
        }
        function remaining() {
          return Math.max(0, DAILY_LIMIT - readQuota().count);
        }

        // ------------------ 保存ボタン初期化 ------------------
        function initSaveButtons() {
          document.querySelectorAll('.lab__btn--save').forEach((btn) => {
            const pmid = btn.getAttribute('data-pmid');
            reflectSaveState(btn, isSaved(pmid));
            btn.addEventListener('click', () => {
              const card = btn.closest('.lab__card');
              const paper = JSON.parse(card.getAttribute('data-paper'));
              const nowSaved = toggleSaved(paper);
              reflectSaveState(btn, nowSaved);
              if (typeof gtag === 'function') {
                gtag('event', nowSaved ? 'lab_save_paper' : 'lab_unsave_paper', {
                  pmid: paper.pmid,
                });
              }
            });
          });
        }
        function reflectSaveState(btn, saved) {
          btn.classList.toggle('is-saved', saved);
          btn.querySelector('.lab__btn-icon').textContent = saved ? '★' : '☆';
          btn.querySelector('.lab__btn-label').textContent = saved ? '保存済み' : '保存';
        }

        // ------------------ 壁打ちチャット初期化 ------------------
        function initChatButtons() {
          document.querySelectorAll('.lab__btn--chat').forEach((btn) => {
            const pmid = btn.getAttribute('data-pmid');
            btn.addEventListener('click', () => {
              const card = btn.closest('.lab__card');
              const chatBox = card.querySelector('.paper-chat');
              const nowOpen = chatBox.hidden;
              chatBox.hidden = !nowOpen;
              btn.classList.toggle('is-active', nowOpen);
              if (nowOpen) {
                updateQuotaDisplay(chatBox);
                if (typeof gtag === 'function') {
                  gtag('event', 'lab_chat_open', { pmid });
                }
                const input = chatBox.querySelector('.paper-chat__input');
                if (input) input.focus();
              }
            });
          });

          document.querySelectorAll('.paper-chat').forEach((box) => {
            const form = box.querySelector('.paper-chat__form');
            const input = box.querySelector('.paper-chat__input');
            const messagesEl = box.querySelector('.paper-chat__messages');
            const submitBtn = box.querySelector('.paper-chat__submit');
            const history = []; // {role, content}[]  session-scoped, not persisted

            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const question = input.value.trim();
              if (!question) return;
              if (remaining() <= 0) {
                appendMessage(messagesEl, 'assistant',
                  '⚠️ 今日の壁打ち回数上限 (3 回) に達しました。日付が変わると再度使えます。');
                appendToolkitLink(messagesEl, 'lab_toolkit_click_chatlimit');
                appendWaitlistLink(messagesEl, 'lab_waitlist_click_chatlimit');
                return;
              }
              const card = box.closest('.lab__card');
              const paper = JSON.parse(card.getAttribute('data-paper'));

              history.push({ role: 'user', content: question });
              appendMessage(messagesEl, 'user', question);
              input.value = '';
              input.disabled = true;
              submitBtn.disabled = true;
              const loadingEl = appendMessage(messagesEl, 'assistant', '考え中…', 'is-loading');

              try {
                const res = await fetch('/api/chat', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({
                    paper: {
                      pmid: paper.pmid,
                      title: paper.title,
                      authors: paper.authors || [],
                      journal: paper.journal,
                      year: paper.year,
                      abstract: paper.abstract,
                    },
                    messages: history,
                  }),
                });
                const data = await res.json().catch(() => ({}));
                loadingEl.remove();
                if (!res.ok) {
                  const msg = data.detail || data.error || `エラー (${res.status})`;
                  appendMessage(messagesEl, 'assistant', `⚠️ ${msg}`, 'is-error');
                  if (typeof gtag === 'function') {
                    gtag('event', 'lab_chat_error', { pmid: paper.pmid, error: data.error || 'http_' + res.status });
                  }
                  return;
                }
                history.push({ role: 'assistant', content: data.reply });
                appendMessage(messagesEl, 'assistant', data.reply);
                bumpQuota();
                updateQuotaDisplay(box);
                if (typeof gtag === 'function') {
                  gtag('event', 'lab_chat_message', {
                    pmid: paper.pmid,
                    turn: history.filter((m) => m.role === 'user').length,
                  });
                }
              } catch (err) {
                loadingEl.remove();
                appendMessage(messagesEl, 'assistant',
                  `⚠️ 通信エラー: ${(err && err.message) || err}`, 'is-error');
              } finally {
                input.disabled = false;
                submitBtn.disabled = false;
                input.focus();
              }
            });
          });
        }
        function appendMessage(container, role, text, extraClass) {
          const el = document.createElement('div');
          el.className = 'chat-msg chat-msg--' + role + (extraClass ? ' ' + extraClass : '');
          el.textContent = text;
          container.appendChild(el);
          el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          return el;
        }
        function appendWaitlistLink(container, gaEventName) {
          const wl = document.querySelector('.lab');
          const url = wl && wl.getAttribute('data-waitlist-url');
          if (!url) return;
          const wrap = document.createElement('div');
          wrap.className = 'chat-msg chat-msg--assistant chat-msg--waitlist';
          wrap.appendChild(document.createTextNode('📱 スマホアプリ (無料・広告付き) 準備中: '));
          const link = document.createElement('a');
          link.href = url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = 'リリース通知を受け取る →';
          link.className = 'chat-msg__waitlist-link';
          link.addEventListener('click', () => {
            if (typeof gtag === 'function') gtag('event', gaEventName || 'lab_waitlist_click');
          });
          wrap.appendChild(link);
          container.appendChild(wrap);
          wrap.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        function appendToolkitLink(container, gaEventName) {
          const wrap = document.createElement('div');
          wrap.className = 'chat-msg chat-msg--assistant chat-msg--waitlist';
          wrap.appendChild(document.createTextNode('🤖 自分の ChatGPT / Claude で無制限に使いたい方は: '));
          const link = document.createElement('a');
          link.href = '/ja/lab/toolkit/';
          link.textContent = '無料プロンプトを取得 →';
          link.className = 'chat-msg__waitlist-link';
          link.addEventListener('click', () => {
            if (typeof gtag === 'function') gtag('event', gaEventName || 'lab_toolkit_click');
          });
          wrap.appendChild(link);
          container.appendChild(wrap);
          wrap.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        function updateQuotaDisplay(box) {
          const el = box.querySelector('.quota-count');
          if (el) el.textContent = String(remaining());
        }

        // ------------------ GA4: 検索実行時 ------------------
        // SSR で結果ページを返した時点で検索は既に完走している。ここではページビュー
        // 相当の custom event を送るだけ。
        if (typeof gtag === 'function') {
          const params = new URLSearchParams(location.search);
          const q = params.get('q') || '';
          if (q) {
            gtag('event', 'lab_search', {
              query: q.slice(0, 100),
              result_count: document.querySelectorAll('.lab__card').length,
            });
          }
        }

        // ------------------ 卒論テーマ提案 ------------------
        function readThemeQuota() {
          try {
            const raw = localStorage.getItem(THEME_QUOTA_KEY);
            const obj = raw ? JSON.parse(raw) : {};
            if (obj.date !== today()) return { date: today(), count: 0 };
            return { date: obj.date, count: obj.count || 0 };
          } catch { return { date: today(), count: 0 }; }
        }
        function bumpThemeQuota() {
          const q = readThemeQuota();
          q.count += 1;
          try { localStorage.setItem(THEME_QUOTA_KEY, JSON.stringify(q)); } catch {}
        }
        function themeRemaining() {
          return Math.max(0, THEME_DAILY_LIMIT - readThemeQuota().count);
        }
        function initThemeSuggest() {
          const section = document.querySelector('.theme-suggest');
          if (!section) return;
          const btn = document.getElementById('theme-suggest-btn');
          const quotaEl = document.getElementById('theme-quota-count');
          const resultEl = document.getElementById('theme-suggest-result');
          const userQuery = section.getAttribute('data-user-query') || '';
          quotaEl.textContent = String(themeRemaining());

          btn.addEventListener('click', async () => {
            if (themeRemaining() <= 0) {
              renderThemeError(resultEl,
                '⚠️ 今日のテーマ提案の上限 (3 回) に達しました。日付が変わると再度使えます。');
              return;
            }
            // 上位 5 件の paper データを DOM から抽出
            const cards = document.querySelectorAll('.lab__card');
            const papers = Array.from(cards).slice(0, 5).map((c) => {
              try {
                const p = JSON.parse(c.getAttribute('data-paper'));
                return {
                  pmid: p.pmid,
                  title: p.title,
                  authors: p.authors || [],
                  journal: p.journal,
                  year: p.year,
                  abstract: p.abstract,
                };
              } catch { return null; }
            }).filter(Boolean);
            if (papers.length === 0) return;

            btn.disabled = true;
            btn.textContent = '⏳ AI が考え中… (10-20秒)';
            resultEl.hidden = false;
            resultEl.innerHTML = '<p class="theme-suggest__loading">🤖 検索結果の論文を俯瞰しています…</p>';
            if (typeof gtag === 'function') {
              gtag('event', 'lab_theme_suggest_click', {
                query: userQuery.slice(0, 100),
                paper_count: papers.length,
              });
            }

            try {
              const res = await fetch('/api/theme-suggest', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ userQuery, papers }),
              });
              const data = await res.json().catch(() => ({}));
              if (!res.ok) {
                renderThemeError(resultEl,
                  '⚠️ ' + (data.detail || data.error || `エラー (${res.status})`));
                if (typeof gtag === 'function') {
                  gtag('event', 'lab_theme_suggest_error', { error: data.error || 'http_' + res.status });
                }
                return;
              }
              renderThemeResult(resultEl, data);
              bumpThemeQuota();
              quotaEl.textContent = String(themeRemaining());
              btn.textContent = themeRemaining() > 0
                ? '🔄 別の角度で提案してもらう'
                : '💡 明日また試せます';
              btn.disabled = themeRemaining() <= 0;
              if (typeof gtag === 'function') {
                gtag('event', 'lab_theme_suggest_success', {
                  query: userQuery.slice(0, 100),
                });
              }
            } catch (err) {
              renderThemeError(resultEl,
                '⚠️ 通信エラー: ' + ((err && err.message) || err));
            } finally {
              if (!btn.disabled) btn.disabled = false;
            }
          });
        }
        function esc(s) {
          return String(s || '').replace(/[&<>"']/g, (c) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
          }[c]));
        }
        function renderThemeError(container, msg) {
          container.innerHTML = '<div class="theme-suggest__error">' + esc(msg) + '</div>';
        }
        function renderThemeResult(container, data) {
          const interests = (data.interests || []).map((k) =>
            '<li>' + esc(k) + '</li>').join('');
          const themes = (data.themes || []).map((t, i) => `
            <li class="theme-item">
              <div class="theme-item__num">${i + 1}</div>
              <div class="theme-item__body">
                <h4 class="theme-item__title">${esc(t.title)}</h4>
                <p class="theme-item__why">${esc(t.why)}</p>
                <a href="#pmid-${esc(t.basedOnPmid)}" class="theme-item__link"
                   onclick="if(typeof gtag==='function')gtag('event','lab_theme_paper_jump',{pmid:'${esc(t.basedOnPmid)}'});">
                  📄 元にした論文を見る (PMID:${esc(t.basedOnPmid)}) →
                </a>
              </div>
            </li>
          `).join('');
          const entry = data.entryPaper || {};
          container.innerHTML = `
            <div class="theme-suggest__section">
              <h3 class="theme-suggest__section-title">🎯 あなたの興味の焦点</h3>
              <ul class="theme-suggest__tags">${interests}</ul>
            </div>
            <div class="theme-suggest__section">
              <h3 class="theme-suggest__section-title">💡 派生研究テーマ 3 案</h3>
              <ol class="theme-suggest__themes">${themes}</ol>
            </div>
            <div class="theme-suggest__section theme-suggest__entry">
              <h3 class="theme-suggest__section-title">📌 最初に精読すべき論文</h3>
              <p class="theme-suggest__entry-why">${esc(entry.why || '')}</p>
              <a href="#pmid-${esc(entry.pmid || '')}" class="theme-suggest__entry-link"
                 onclick="if(typeof gtag==='function')gtag('event','lab_theme_entry_jump',{pmid:'${esc(entry.pmid || '')}'});">
                📄 この論文 (PMID:${esc(entry.pmid || '')}) にジャンプ →
              </a>
            </div>
            <p class="theme-suggest__disclaimer">
              ⚠️ 上記は AI (Claude) が abstract を元に提案したものです。指導教官の意見・研究倫理審査・実施可能性は必ず自分で確認してください。
            </p>
          `;
        }

        // ------------------ [data-ga-event] を click 時に発火 (waitlist 等) ------------------
        function initGaEventLinks() {
          document.querySelectorAll('[data-ga-event]').forEach((el) => {
            el.addEventListener('click', () => {
              if (typeof gtag === 'function') {
                gtag('event', el.getAttribute('data-ga-event'));
              }
            });
          });
        }

        // init
        initSaveButtons();
        initChatButtons();
        initThemeSuggest();
        initGaEventLinks();
      })();
    </script>
  )}

  {!q && (
    <script is:inline>
      // トップページ: 検索 submit + waitlist などの [data-ga-event] リンク
      (function() {
        const form = document.getElementById('lab-search-form');
        if (form) {
          form.addEventListener('submit', () => {
            const q = form.querySelector('input[name="q"]').value.trim();
            if (typeof gtag === 'function' && q) {
              gtag('event', 'lab_search_submit', { query: q.slice(0, 100) });
            }
          });
        }
        document.querySelectorAll('[data-ga-event]').forEach((el) => {
          el.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', el.getAttribute('data-ga-event'));
            }
          });
        });
      })();
    </script>
  )}

