---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const psy = await getCollection('ja_psychology');
const bio = await getCollection('ja_biology');
const all = [...psy, ...bio].sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);
const catLabelJa: Record<string, string> = {
  psychology: '心理学',
  biology: '生物学',
};

export const prerender = true;
---
<BaseLayout
  title="PubMed Trivia ｜ 論文ベースの豆知識"
  description="心理学・睡眠・記憶・進化・行動など、PubMedの論文から1日数本の豆知識をお届け。"
  lang="ja"
>
  <h1>PubMed Trivia</h1>
  <p>論文ベースの豆知識を毎日お届け。出典は全て PubMed (NIH 公式論文DB)。</p>

  {/* 🔬 Lab の CTA カード (トップの一等地に配置) */}
  <aside class="lab-cta">
    <div class="lab-cta__left">
      <p class="lab-cta__label">🔬 NEW</p>
      <h2 class="lab-cta__title">PubMed Lab — 日本語で論文を探せる</h2>
      <p class="lab-cta__body">
        日本語で入力するだけで、PubMed の英語論文を検索できるリサーチアシスタント。<br>
        卒論・研究テーマ探しに。無料で使えます。
      </p>
    </div>
    <div class="lab-cta__right">
      <a href="/ja/lab/" class="lab-cta__button">🔍 Lab を試す →</a>
    </div>
  </aside>

  <ul class="card-grid">
    {all.map((post) => (
      <li class="card">
        <a href={`/ja/${post.data.category}/${post.id}/`}>{post.data.title}</a>
        <p class="card__fact">{post.data.fact}</p>
        <div class="card__meta">
          <span class={`tag tag--${post.data.category}`}>{catLabelJa[post.data.category]}</span>
          {post.data.journal && <span>{post.data.journal}{post.data.year && ` · ${post.data.year}`}</span>}
        </div>
      </li>
    ))}
  </ul>

  <style>
    .lab-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin: 24px 0 32px;
      padding: 24px 28px;
      background: linear-gradient(135deg, #1a365d 0%, #2a4a7d 100%);
      border-radius: 12px;
      color: white;
      box-shadow: 0 6px 20px rgba(26, 54, 93, 0.2);
    }
    .lab-cta__label {
      display: inline-block;
      background: #fbbf24;
      color: #1a365d;
      font-size: 0.7rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 4px;
      margin: 0 0 8px;
      letter-spacing: 1px;
    }
    .lab-cta__title {
      font-size: 1.35rem;
      font-weight: 700;
      margin: 0 0 8px;
      color: white;
    }
    .lab-cta__body {
      font-size: 0.95rem;
      line-height: 1.7;
      margin: 0;
      color: rgba(255, 255, 255, 0.92);
    }
    .lab-cta__button {
      display: inline-block;
      background: #fbbf24;
      color: #1a365d !important;
      padding: 12px 20px;
      border-radius: 8px;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      transition: transform 0.15s, background 0.15s;
    }
    .lab-cta__button:hover {
      background: #f59e0b;
      transform: translateY(-2px);
    }
    @media (max-width: 640px) {
      .lab-cta { flex-direction: column; align-items: stretch; }
      .lab-cta__right { text-align: center; }
    }
  </style>
</BaseLayout>
