---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const psy = await getCollection('ja_psychology');
const bio = await getCollection('ja_biology');
const all = [...psy, ...bio];
const totalCount = all.length;

// Featured deep-dive slugs (最重要記事、手動 キュレーション)
const featuredSlugs = [
  '20260921-adult-adhd-evidence',
  '20260921-gut-microbiome-mental-health',
  '20260921-hsp-highly-sensitive-person',
  '20260922-child-adhd-evidence',
  '20260922-exercise-depression-evidence',
  '20260922-cognitive-behavioral-therapy-evidence',
  '20260922-mindfulness-meditation-evidence',
  '20260922-sleep-deprivation-health-evidence',
];
const featured = featuredSlugs
  .map((slug) => all.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// 最新 20 記事 (深掘り記事 除外して、単一論文 記事のみ)
const recent = all
  .filter((p) => !featuredSlugs.includes(p.id))
  .sort((a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at))
  .slice(0, 20);

const catLabelJa: Record<string, string> = {
  psychology: '心理学',
  biology: '生物学',
};

export const prerender = true;
---
<BaseLayout
  title="PubMed Trivia ｜ PubMed の論文を 日本語で 読める 科学メディア"
  description="PubMed 掲載の 系統的レビュー・メタ解析を 日本語で 解説。ADHD、腸内フローラ、睡眠、CBT など テーマ別 深掘り記事 + AI 論文検索ツール。全て 無料。"
  lang="ja"
>
  {/* Hero */}
  <section class="hero">
    <p class="hero__eyebrow">Science For Life</p>
    <h1>PubMed の 論文を 日本語で。</h1>
    <p class="hero__body">
      NIH 公式 論文 DB「PubMed」の 系統的レビュー・メタ解析 を 日本語で わかりやすく 解説。
      <strong>全 {totalCount} 本 の 記事</strong> は 無料、出典 論文の PMID を 全て 明記しています。
    </p>
    <div class="hero__ctas">
      <a href="/ja/lab/" class="btn btn--primary">🔬 PubMed Lab を 試す</a>
      <a href="/ja/hub/" class="btn btn--outline">📚 テーマ別 ハブ</a>
      <a href="/ja/search/" class="btn btn--outline">🔍 記事を 検索</a>
    </div>
  </section>

  {/* Featured Deep-Dives */}
  <section class="section">
    <div class="section__head">
      <h2>🌟 深掘りレビュー</h2>
      <p>10 本前後の 系統的レビュー・メタ解析を 統合した エビデンス総合記事。月 数本 追加。</p>
    </div>
    <ul class="feature-grid">
      {featured.map((p) => (
        <li class="feature">
          <a href={`/ja/${p.data.category}/${p.id}/`}>
            <span class={`feature__badge feature__badge--${p.data.category}`}>{catLabelJa[p.data.category]}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.fact}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* Topic Hubs */}
  <section class="section">
    <div class="section__head">
      <h2>📚 テーマ別 ハブ</h2>
      <p>関心の 高い テーマごとに、主要記事と 編集的解説を まとめました。</p>
    </div>
    <ul class="hub-tile-grid">
      <li><a href="/ja/hub/adhd/" class="hub-tile"><span class="hub-tile__emoji">🧠</span><span class="hub-tile__label">ADHD</span></a></li>
      <li><a href="/ja/hub/gut-microbiome/" class="hub-tile"><span class="hub-tile__emoji">🦠</span><span class="hub-tile__label">腸内フローラ</span></a></li>
      <li><a href="/ja/hub/sleep/" class="hub-tile"><span class="hub-tile__emoji">😴</span><span class="hub-tile__label">睡眠</span></a></li>
      <li><a href="/ja/hub/exercise/" class="hub-tile"><span class="hub-tile__emoji">🏃</span><span class="hub-tile__label">運動</span></a></li>
      <li><a href="/ja/hub/cbt/" class="hub-tile"><span class="hub-tile__emoji">🧘</span><span class="hub-tile__label">CBT</span></a></li>
      <li><a href="/ja/hub/" class="hub-tile hub-tile--more"><span class="hub-tile__emoji">→</span><span class="hub-tile__label">全ハブ</span></a></li>
    </ul>
  </section>

  {/* Categories */}
  <section class="section">
    <div class="section__head">
      <h2>🗂 カテゴリで 見る</h2>
    </div>
    <div class="cat-grid">
      <a href="/ja/psychology/" class="cat-card cat-card--psy">
        <h3>心理学 <span class="cat-card__count">{psy.length} 本</span></h3>
        <p>認知・行動・感情・発達・臨床心理・神経科学</p>
      </a>
      <a href="/ja/biology/" class="cat-card cat-card--bio">
        <h3>生物学 <span class="cat-card__count">{bio.length} 本</span></h3>
        <p>細胞・遺伝子・進化・微生物・生理学・生態学</p>
      </a>
    </div>
  </section>

  {/* Recent articles */}
  <section class="section">
    <div class="section__head">
      <h2>🆕 新着 記事</h2>
      <p>直近 20 本 の 個別論文由来 記事。</p>
    </div>
    <ul class="card-grid">
      {recent.map((post) => (
        <li class="card">
          <a href={`/ja/${post.data.category}/${post.id}/`}>{post.data.title}</a>
          <p class="card__fact">{post.data.fact}</p>
          <div class="card__meta">
            <span class={`tag tag--${post.data.category}`}>{catLabelJa[post.data.category]}</span>
            {post.data.journal && <span>{post.data.journal}{post.data.year && ` · ${post.data.year}`}</span>}
          </div>
        </li>
      ))}
    </ul>
    <p class="section__more"><a href="/ja/archive/">📅 全記事 (年別アーカイブ) を 見る →</a></p>
  </section>

  {/* Editorial */}
  <section class="section section--editorial">
    <div class="section__head">
      <h2>📝 このサイトについて</h2>
    </div>
    <p>
      本サイトは、PubMed の 査読付き論文 (特に 系統的レビュー・メタ解析) を 題材に、
      日本語話者にも 科学的な 一次情報を 届けることを 目的とした メディアです。
      Claude AI で 翻案し、薬機法 NG 表現 の 自動フィルタを 通して 公開。
      詳細は <a href="/ja/editorial-policy/">編集方針</a> を ご覧ください。
    </p>
    <ul class="editorial-links">
      <li><a href="/ja/editorial-policy/">📝 編集方針</a></li>
      <li><a href="/ja/guide/how-to-read-research/">📖 論文の 読み方</a></li>
      <li><a href="/ja/guide/paper-critique/">✔️ 論文批判的読み方</a></li>
      <li><a href="/ja/guide/effect-size-guide/">📊 効果量</a></li>
      <li><a href="/ja/guide/meta-analysis-guide/">📊 メタ解析</a></li>
      <li><a href="/ja/guide/pubmed-search-guide/">🔍 PubMed 検索ガイド</a></li>
      <li><a href="/ja/guide/faq/">❓ FAQ</a></li>
    </ul>
  </section>

  <style>
    /* ---- Hero ---- */
    .hero { text-align: center; padding: 32px 20px 24px; }
    .hero__eyebrow { font-size: 0.78rem; color: #7c3aed; font-weight: 700; letter-spacing: 0.15em; margin: 0 0 8px; }
    .hero h1 { font-size: 2.2rem; color: var(--navy); margin: 0 0 12px; letter-spacing: -0.01em; }
    .hero__body { color: #4a5568; line-height: 1.85; max-width: 620px; margin: 0 auto 22px; }
    .hero__ctas { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; padding: 12px 22px; border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 0.95rem; transition: transform 0.15s, box-shadow 0.15s; }
    .btn--primary { background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%); color: var(--navy) !important; border: 1px solid #d97706; box-shadow: 0 3px 0 rgba(0,0,0,0.08); }
    .btn--primary:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(217, 119, 6, 0.3); }
    .btn--outline { background: white; color: var(--navy) !important; border: 1px solid #d5dceb; }
    .btn--outline:hover { border-color: var(--navy); }

    /* ---- Section common ---- */
    .section { margin: 40px 0; padding: 0; }
    .section__head { margin: 0 0 16px; }
    .section__head h2 { font-size: 1.35rem; color: var(--navy); margin: 0 0 6px; padding-left: 12px; border-left: 5px solid var(--navy); }
    .section__head p { color: var(--muted); font-size: 0.9rem; margin: 4px 0 0; }
    .section__more { text-align: center; margin-top: 20px; }
    .section__more a { color: var(--link); font-weight: 600; }

    /* ---- Featured deep-dive grid ---- */
    .feature-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
    .feature { background: linear-gradient(180deg, #fff8ea 0%, #fef4d8 100%); border: 1px solid #f0d78a; border-radius: 10px; transition: transform 0.15s, box-shadow 0.15s; }
    .feature:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(217, 119, 6, 0.15); }
    .feature a { display: block; padding: 16px 18px; text-decoration: none; color: var(--navy); }
    .feature__badge { display: inline-block; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; color: white; letter-spacing: 0.05em; }
    .feature__badge--psychology { background: #7c3aed; }
    .feature__badge--biology { background: #059669; }
    .feature h3 { font-size: 1rem; margin: 8px 0 6px; line-height: 1.4; color: var(--navy); }
    .feature p { font-size: 0.86rem; color: #4a5568; line-height: 1.6; margin: 0; }

    /* ---- Hub tile grid ---- */
    .hub-tile-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; }
    .hub-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px 10px; background: white; border: 1px solid #d5dceb; border-radius: 12px; text-decoration: none; color: var(--navy); transition: transform 0.15s, border-color 0.15s; text-align: center; min-height: 100px; }
    .hub-tile:hover { transform: translateY(-2px); border-color: var(--navy); }
    .hub-tile__emoji { font-size: 1.8rem; margin-bottom: 6px; }
    .hub-tile__label { font-size: 0.82rem; font-weight: 600; }
    .hub-tile--more { background: #f7f9fc; }

    /* ---- Category card ---- */
    .cat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 480px) { .cat-grid { grid-template-columns: 1fr; } }
    .cat-card { display: block; padding: 18px 20px; border-radius: 10px; text-decoration: none; color: var(--navy); transition: transform 0.15s, box-shadow 0.15s; border: 1px solid transparent; }
    .cat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(0,0,0,0.08); }
    .cat-card--psy { background: linear-gradient(180deg, #ede9fe 0%, #ddd6fe 100%); border-color: #a78bfa; }
    .cat-card--bio { background: linear-gradient(180deg, #d1fae5 0%, #a7f3d0 100%); border-color: #34d399; }
    .cat-card h3 { font-size: 1.15rem; margin: 0 0 6px; color: var(--navy); }
    .cat-card__count { font-size: 0.8rem; color: var(--muted); font-weight: 500; }
    .cat-card p { margin: 0; font-size: 0.86rem; color: #4a5568; line-height: 1.5; }

    /* ---- Editorial section ---- */
    .section--editorial { background: #f7f9fc; padding: 24px; border-radius: 12px; }
    .section--editorial p { line-height: 1.85; color: #4a5568; }
    .editorial-links { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .editorial-links a { display: inline-block; padding: 6px 12px; background: white; border: 1px solid #d5dceb; border-radius: 999px; font-size: 0.85rem; text-decoration: none; color: var(--navy); }
    .editorial-links a:hover { border-color: var(--navy); }
  </style>
</BaseLayout>
