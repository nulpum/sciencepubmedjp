---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const psy = await getCollection('en_psychology');
const bio = await getCollection('en_biology');
const all = [...psy, ...bio].sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);
---
<BaseLayout title="PubMed Trivia (English)" lang="en">
  <h1>PubMed Trivia</h1>
  <p>Daily research-backed trivia from PubMed.</p>
  <ul>
    {all.map((post) => (
      <li>
        <a href={`/en/${post.data.category}/${post.id}/`}>{post.data.title}</a>
        <small>（{post.data.category}）</small>
      </li>
    ))}
  </ul>
</BaseLayout>
