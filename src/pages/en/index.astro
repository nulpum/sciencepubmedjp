---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const psy = await getCollection('en_psychology');
const bio = await getCollection('en_biology');
const all = [...psy, ...bio].sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);
const catLabel: Record<string, string> = {
  psychology: 'Psychology',
  biology: 'Biology',
};

export const prerender = true;
---
<BaseLayout
  title="PubMed Trivia ｜ Research-backed daily trivia"
  description="Daily science trivia drawn from PubMed reviews — psychology, sleep, memory, evolution, and more."
  lang="en"
>
  <h1>PubMed Trivia</h1>
  <p>Daily science trivia, each one drawn from PubMed reviews.</p>

  <ul class="card-grid">
    {all.map((post) => (
      <li class="card">
        <a href={`/en/${post.data.category}/${post.id}/`}>{post.data.title}</a>
        <p class="card__fact">{post.data.fact}</p>
        <div class="card__meta">
          <span class={`tag tag--${post.data.category}`}>{catLabel[post.data.category]}</span>
          {post.data.journal && <span>{post.data.journal}{post.data.year && ` · ${post.data.year}`}</span>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
