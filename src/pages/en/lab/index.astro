---
// PubMed Lab (EN) — search PubMed + AI chat about individual papers.
// UX matches JA Lab: inline chat below each paper card (not modal).

import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdUnit from '../../../components/AdUnit.astro';
import { searchPmids, fetchArticles, pubmedUrl } from '../../../lib/pubmed';
import { getCollection } from 'astro:content';

export const prerender = false;

function getEnv(locals: any, key: string): string | undefined {
  const cf = locals?.runtime?.env;
  if (cf && key in cf) return cf[key];
  return typeof process !== 'undefined' ? process.env[key] : undefined;
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim();

interface ResultItem {
  pmid: string;
  title: string;
  authors: string[];
  journal?: string;
  year?: number;
  abstract: string;
  url: string;
}

let results: ResultItem[] = [];
let siteMatches: { slug: string; category: string; title: string; fact: string; url: string }[] = [];
let totalCount = 0;
let elapsedMs = 0;
let errorMessage = '';

if (q) {
  const startedAt = Date.now();
  try {
    const pubmedCfg = {
      tool: getEnv(Astro.locals, 'PUBMED_TOOL') || 'pubmed-trivia-lab',
      email: getEnv(Astro.locals, 'PUBMED_EMAIL') || 'sciencepubmedjp@gmail.com',
      apiKey: getEnv(Astro.locals, 'PUBMED_API_KEY') || undefined,
    };

    const { pmids, total } = await searchPmids(pubmedCfg, q, 10);
    totalCount = total;

    if (pmids.length > 0) {
      const articles = await fetchArticles(pubmedCfg, pmids);
      results = articles.map((a) => ({
        pmid: a.pmid,
        title: a.title,
        authors: a.authors.slice(0, 3),
        journal: a.journal,
        year: a.year,
        abstract: a.abstract,
        url: pubmedUrl(a.pmid),
      }));
    }
    elapsedMs = Date.now() - startedAt;

    try {
      const psy = await getCollection('en_psychology');
      const bio = await getCollection('en_biology');
      const all = [...psy, ...bio];
      const tokens = q.toLowerCase().split(/[\s,.]+/).filter((t) => t.length >= 3);
      const scored = all
        .map((p) => {
          const haystack = (p.data.title + ' ' + p.data.fact).toLowerCase();
          let score = 0;
          for (const t of tokens) {
            if (haystack.includes(t)) score++;
          }
          return { post: p, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 4);
      siteMatches = scored.map((x) => ({
        slug: x.post.id,
        category: x.post.data.category,
        title: x.post.data.title,
        fact: x.post.data.fact,
        url: `/en/${x.post.data.category}/${x.post.id}/`,
      }));
    } catch { /* ignore */ }
  } catch (e) {
    errorMessage = (e as Error).message || String(e);
  }
}

const sampleQueries = [
  'sleep deprivation and academic performance',
  'cognitive behavioral therapy for ADHD in children',
  'gut microbiome and depression meta-analysis',
  'highly sensitive person neuroscience',
  'mindfulness meditation systematic review anxiety',
  'exercise and cognitive decline prevention',
  'intermittent fasting metabolic health',
  'GLP-1 receptor agonists brain reward',
];
---
<BaseLayout
  title="PubMed Lab — Search papers + AI chat｜PubMed Trivia"
  description="Free AI-assisted PubMed search. Type a research question in plain English, get relevant papers, and chat inline with an AI about any paper's methods, findings, and limits."
  lang="en"
  ogType="website"
>
  <div class="lab">
    <header class="lab__header">
      <p class="lab__breadcrumb"><a href="/en/">Home</a> › 🔬 PubMed Lab</p>
      <h1>🔬 PubMed Lab <span class="lab__badge">Free · No signup</span></h1>
      <p class="lab__intro">
        Search PubMed with a plain-English research question, then <strong>chat with an AI</strong> about any paper.
        Powered by Claude (Anthropic) + NIH PubMed E-utilities.
      </p>
    </header>

    <form class="lab__form" action="/en/lab/" method="get">
      <label for="lab-q" class="visually-hidden">Search query</label>
      <input
        id="lab-q"
        type="search"
        name="q"
        value={q}
        placeholder="e.g. gut microbiome depression meta-analysis"
        autocomplete="off"
        spellcheck="false"
        class="lab__input"
      />
      <button type="submit" class="lab__submit">🔍 Search</button>
    </form>

    {!q && (
      <section class="lab__samples" aria-label="Sample queries">
        <p class="lab__samples-label">Try one of these to see it in action:</p>
        <ul class="lab__samples-list">
          {sampleQueries.map((s) => (
            <li><a href={`/en/lab/?q=${encodeURIComponent(s)}`}>{s}</a></li>
          ))}
        </ul>
      </section>
    )}

    {q && errorMessage && (
      <div class="lab__error">
        <strong>Error:</strong> {errorMessage}
      </div>
    )}

    {q && !errorMessage && results.length === 0 && (
      <div class="lab__empty">
        <p>No papers matched <strong>"{q}"</strong>. Try broadening your query or checking spelling.</p>
      </div>
    )}

    {q && results.length > 0 && (
      <section class="lab__results">
        <p class="lab__meta">
          <strong>{results.length}</strong> of ~<strong>{totalCount.toLocaleString()}</strong> matches ·
          <span class="lab__timing"> {elapsedMs} ms</span>
        </p>

        {siteMatches.length > 0 && (
          <aside class="lab__site-matches">
            <p class="lab__site-matches-label">✨ Related articles on this site:</p>
            <ul>
              {siteMatches.map((m) => (
                <li><a href={m.url}>{m.title}</a></li>
              ))}
            </ul>
          </aside>
        )}

        <ol class="lab__result-list">
          {results.map((r, i) => (
            <li class="lab__result" data-pmid={r.pmid}>
              <div class="lab__result-meta">
                <span class="lab__result-num">#{i + 1}</span>
                {r.journal && <span>{r.journal}</span>}
                {r.year && <span>({r.year})</span>}
              </div>
              <h3 class="lab__result-title">
                <a href={r.url} rel="noopener" target="_blank">{r.title}</a>
              </h3>
              {r.authors.length > 0 && (
                <p class="lab__result-authors">{r.authors.join(', ')}{r.authors.length >= 3 ? ' et al.' : ''}</p>
              )}
              <p class="lab__result-abstract">
                {r.abstract.slice(0, 400)}{r.abstract.length > 400 ? '…' : ''}
              </p>
              <div class="lab__result-actions">
                <a href={r.url} class="lab__btn lab__btn--pubmed" rel="noopener" target="_blank">🔗 Open on PubMed</a>
                <button
                  type="button"
                  class="lab__btn lab__btn--chat"
                  data-chat-toggle
                  data-pmid={r.pmid}
                >💬 Chat with AI</button>
              </div>

              {/* Inline chat (initially hidden, toggled by 💬 button) */}
              <div class="paper-chat" data-chat-for={r.pmid} data-title={r.title} data-abstract={r.abstract} hidden>
                <div class="paper-chat__head">
                  <span class="paper-chat__title">💬 Chat with AI about this paper (β)</span>
                  <span class="paper-chat__quota">Remaining <span class="quota-count">3</span> / 3 today</span>
                </div>
                <div class="paper-chat__notice">
                  Answers use only the paper's abstract. Not medical advice. Missing info returns "not stated in abstract."
                </div>
                <div class="paper-chat__messages"></div>
                <form class="paper-chat__form">
                  <input
                    type="text"
                    class="paper-chat__input"
                    placeholder="e.g. Summarize the 3 key findings / Sample size and stats? / Limitations?"
                    maxlength="500"
                    required
                  />
                  <button type="submit" class="paper-chat__submit">Send</button>
                </form>
                <p class="paper-chat__hint">
                  Question examples: "Summarize the 3 key findings" · "Limitations?" · "N and statistical method?" · "Possible counter-argument?"
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <AdUnit slot="articleFooter" />

    <section class="lab__faq">
      <h2>❓ How it works</h2>
      <details>
        <summary><strong>What does this do?</strong></summary>
        <p>You type a research question in English. We query the NIH PubMed database and show the top 10 most relevant. Click "💬 Chat with AI" below any paper to ask questions about its methods, findings, and limitations — inline, right below the paper.</p>
      </details>
      <details>
        <summary><strong>Is this free?</strong></summary>
        <p>Yes, and no signup is required. Funded by affiliate links + ads elsewhere on the site.</p>
      </details>
      <details>
        <summary><strong>Any usage limit?</strong></summary>
        <p>3 chat messages per browser per day (cost control). Search itself is unlimited.</p>
      </details>
      <details>
        <summary><strong>Do you store my queries?</strong></summary>
        <p>Queries appear in server logs (retained ~14 days for abuse prevention) and are sent to Anthropic's Claude API for chat (Anthropic's terms apply). Not sold to third parties.</p>
      </details>
      <details>
        <summary><strong>Medical disclaimer?</strong></summary>
        <p>The AI answers are general education, not medical advice. Consult a qualified professional for any health decision. See our <a href="/en/editorial-policy/">editorial policy</a>.</p>
      </details>
    </section>
  </div>

  {q && !errorMessage && results.length > 0 && (
    <script is:inline>
      (function () {
        var QUOTA_KEY = 'labchat_quota_en_v1';
        var DAILY_LIMIT = 3;

        function today() {
          var d = new Date();
          return d.getUTCFullYear() + '-' + (d.getUTCMonth() + 1) + '-' + d.getUTCDate();
        }
        function getQuota() {
          try {
            var raw = localStorage.getItem(QUOTA_KEY);
            if (!raw) return { date: today(), used: 0 };
            var q = JSON.parse(raw);
            if (q.date !== today()) return { date: today(), used: 0 };
            return q;
          } catch (e) { return { date: today(), used: 0 }; }
        }
        function saveQuota(q) {
          try { localStorage.setItem(QUOTA_KEY, JSON.stringify(q)); } catch (e) {}
        }
        function remainingCount() {
          return Math.max(0, DAILY_LIMIT - getQuota().used);
        }
        function updateQuotaDisplay() {
          var counts = document.querySelectorAll('.quota-count');
          var rem = remainingCount();
          counts.forEach(function (el) { el.textContent = String(rem); });
        }

        // Toggle inline chat visibility
        document.addEventListener('click', function (ev) {
          var btn = ev.target && ev.target.closest && ev.target.closest('[data-chat-toggle]');
          if (!btn) return;
          var pmid = btn.dataset.pmid;
          var chat = document.querySelector('[data-chat-for="' + pmid + '"]');
          if (!chat) return;
          if (chat.hidden) {
            chat.hidden = false;
            btn.textContent = '✕ Close chat';
            var input = chat.querySelector('.paper-chat__input');
            if (input) setTimeout(function () { input.focus(); }, 100);
            if (typeof gtag === 'function') gtag('event', 'lab_chat_open', { pmid: pmid });
          } else {
            chat.hidden = true;
            btn.textContent = '💬 Chat with AI';
          }
        });

        // Chat form submit
        document.addEventListener('submit', function (ev) {
          var form = ev.target;
          if (!form.classList || !form.classList.contains('paper-chat__form')) return;
          ev.preventDefault();

          var chat = form.closest('.paper-chat');
          var pmid = chat.getAttribute('data-chat-for');
          var title = chat.getAttribute('data-title') || '';
          var abstract = chat.getAttribute('data-abstract') || '';
          var input = form.querySelector('.paper-chat__input');
          var messages = chat.querySelector('.paper-chat__messages');
          var q = input.value.trim();
          if (!q) return;

          // Quota check
          var quota = getQuota();
          if (quota.used >= DAILY_LIMIT) {
            appendMsg(messages, 'system', '⚠️ You have used all 3 messages for today. Comes back tomorrow (UTC).');
            return;
          }

          input.value = '';
          appendMsg(messages, 'user', q);
          appendLoading(messages);

          if (typeof gtag === 'function') {
            gtag('event', 'lab_chat_message', { pmid: pmid, message_len: q.length });
          }

          // Build history from existing messages
          var history = [];
          Array.from(messages.querySelectorAll('.paper-chat__msg')).forEach(function (m) {
            var role = m.dataset.role;
            if (role === 'user' || role === 'assistant') {
              history.push({ role: role, content: m.textContent || '' });
            }
          });

          fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              paper: { pmid: pmid, title: title, authors: [], abstract: abstract },
              messages: history,
            }),
          })
            .then(function (r) { return r.json().then(function (data) { return { status: r.status, data: data }; }); })
            .then(function (res) {
              removeLoading(messages);
              var data = res.data || {};
              if (res.status >= 400 || data.error) {
                var detail = data.detail || data.error || ('HTTP ' + res.status);
                appendMsg(messages, 'assistant', 'Error: ' + detail);
                return;
              }
              var reply = data.reply || '(Empty response)';
              appendMsg(messages, 'assistant', reply);
              // Increment quota
              quota.used += 1;
              saveQuota(quota);
              updateQuotaDisplay();
            })
            .catch(function (err) {
              removeLoading(messages);
              appendMsg(messages, 'assistant', 'Network error: ' + err.message);
            });
        });

        function appendMsg(container, role, text) {
          var el = document.createElement('p');
          el.className = 'paper-chat__msg paper-chat__msg--' + role;
          el.setAttribute('data-role', role);
          el.textContent = text;
          container.appendChild(el);
          container.scrollTop = container.scrollHeight;
        }
        function appendLoading(container) {
          var el = document.createElement('p');
          el.className = 'paper-chat__msg paper-chat__msg--loading';
          el.textContent = 'Thinking…';
          el.id = 'chat-loading-' + Date.now();
          container.appendChild(el);
          container.scrollTop = container.scrollHeight;
        }
        function removeLoading(container) {
          var loading = container.querySelector('.paper-chat__msg--loading');
          if (loading) loading.remove();
        }

        updateQuotaDisplay();
      })();
    </script>
  )}

  <style>
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    .lab { max-width: 820px; margin: 0 auto; padding: 24px 20px 48px; }
    .lab__breadcrumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 8px; }
    .lab__breadcrumb a { color: var(--muted); }
    .lab__header h1 { font-size: 1.9rem; color: var(--navy); margin: 8px 0 12px; }
    .lab__badge { display: inline-block; background: #059669; color: white; font-size: 0.7rem; padding: 3px 10px; border-radius: 999px; vertical-align: middle; margin-left: 8px; font-weight: 600; }
    .lab__intro { line-height: 1.85; color: #4a5568; }

    .lab__form { display: flex; gap: 10px; margin: 24px 0 20px; }
    .lab__input { flex: 1; padding: 14px 18px; border: 2px solid #d5dceb; border-radius: 12px; font-size: 1.05rem; color: var(--navy); background: white; }
    .lab__input:focus { outline: none; border-color: var(--navy); box-shadow: 0 0 0 3px rgba(26,54,93,0.12); }
    .lab__submit { padding: 14px 24px; background: var(--navy); color: white; border: 0; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 1rem; }
    .lab__submit:hover { background: var(--navy-deep); }

    .lab__samples { background: #f7f9fc; padding: 16px 20px; border-radius: 10px; margin: 16px 0; }
    .lab__samples-label { margin: 0 0 8px; color: var(--muted); font-size: 0.9rem; }
    .lab__samples-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .lab__samples-list a { display: inline-block; padding: 6px 12px; background: white; border: 1px solid #d5dceb; border-radius: 999px; text-decoration: none; color: var(--navy); font-size: 0.85rem; }
    .lab__samples-list a:hover { border-color: var(--navy); }

    .lab__error, .lab__empty { padding: 14px 18px; border-radius: 8px; margin: 16px 0; }
    .lab__error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .lab__empty { background: #fafbfc; color: var(--muted); }

    .lab__meta { color: var(--muted); font-size: 0.9rem; margin: 8px 0 16px; }
    .lab__timing { color: #6b7280; font-size: 0.8rem; }

    .lab__site-matches { background: linear-gradient(180deg, #f0f7ec 0%, #e5f2df 100%); border: 1px solid #b5d4a3; padding: 12px 16px; border-radius: 8px; margin: 12px 0 20px; }
    .lab__site-matches-label { font-weight: 700; color: #2e6320; margin: 0 0 6px; font-size: 0.95rem; }
    .lab__site-matches ul { margin: 0; padding-left: 22px; }
    .lab__site-matches a { color: #2e6320; }

    .lab__result-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
    .lab__result { border: 1px solid #e5e9f2; background: white; border-radius: 10px; padding: 16px 18px; }
    .lab__result-meta { font-size: 0.78rem; color: var(--muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .lab__result-num { background: #f0f4fa; color: var(--navy); padding: 2px 8px; border-radius: 999px; font-weight: 700; }
    .lab__result-title { font-size: 1.05rem; margin: 6px 0; line-height: 1.4; }
    .lab__result-title a { color: var(--navy); text-decoration: none; }
    .lab__result-title a:hover { text-decoration: underline; }
    .lab__result-authors { color: var(--muted); font-size: 0.85rem; margin: 4px 0; font-style: italic; }
    .lab__result-abstract { font-size: 0.9rem; line-height: 1.6; margin: 8px 0; color: #4a5568; }
    .lab__result-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .lab__btn { padding: 8px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #d5dceb; background: white; color: var(--navy); cursor: pointer; }
    .lab__btn:hover { border-color: var(--navy); }
    .lab__btn--pubmed { background: #f0f4fa; }
    .lab__btn--chat { background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%); color: white; border-color: #d97706; }
    .lab__btn--chat:hover { filter: brightness(1.05); }

    /* Inline chat panel */
    .paper-chat { margin-top: 14px; padding: 14px 16px; background: #fafbfc; border: 1px solid #d5dceb; border-radius: 10px; }
    .paper-chat__head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap; }
    .paper-chat__title { font-weight: 700; color: var(--navy); font-size: 0.9rem; }
    .paper-chat__quota { font-size: 0.78rem; color: var(--muted); }
    .paper-chat__quota .quota-count { font-weight: 700; color: var(--navy); }
    .paper-chat__notice { font-size: 0.78rem; color: #7a5a1e; background: #fff8e1; padding: 6px 10px; border-radius: 6px; margin: 6px 0 10px; }
    .paper-chat__messages { max-height: 320px; overflow-y: auto; padding: 4px 0; }
    .paper-chat__msg { padding: 8px 12px; border-radius: 8px; margin: 6px 0; line-height: 1.55; font-size: 0.9rem; }
    .paper-chat__msg--user { background: #e5e9f2; color: var(--navy); }
    .paper-chat__msg--assistant { background: white; color: #1a202c; border: 1px solid #e5e9f2; }
    .paper-chat__msg--loading { color: var(--muted); font-style: italic; }
    .paper-chat__msg--system { background: #fff8e1; color: #7a5a1e; font-size: 0.85rem; }
    .paper-chat__form { display: flex; gap: 8px; margin-top: 8px; }
    .paper-chat__form input { flex: 1; padding: 8px 12px; border: 1px solid #d5dceb; border-radius: 6px; font-size: 0.9rem; }
    .paper-chat__form input:focus { outline: none; border-color: var(--navy); }
    .paper-chat__submit { padding: 8px 16px; background: var(--navy); color: white; border: 0; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.9rem; }
    .paper-chat__submit:hover { background: var(--navy-deep); }
    .paper-chat__hint { font-size: 0.75rem; color: var(--muted); margin: 6px 0 0; font-style: italic; }

    .lab__faq { margin-top: 40px; padding: 20px 24px; background: #f7f9fc; border-radius: 10px; }
    .lab__faq h2 { font-size: 1.2rem; color: var(--navy); margin: 0 0 12px; }
    .lab__faq details { margin: 8px 0; padding: 8px 12px; background: white; border: 1px solid #e5e9f2; border-radius: 8px; }
    .lab__faq summary { cursor: pointer; padding: 4px 0; }
    .lab__faq p { line-height: 1.7; margin: 8px 0; }
  </style>
</BaseLayout>
