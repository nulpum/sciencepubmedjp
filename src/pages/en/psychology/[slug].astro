---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('en_psychology');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);

const related = (all as typeof post[])
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at))
  .slice(0, 3);

const ogImage = `/og/en/${post.id}.png`;
---
<BaseLayout title={post.data.title} description={post.data.fact} lang="en" ogType="article" ogImage={ogImage}>
  <article>
    <h1>{post.data.title}</h1>
    <p><strong>{post.data.fact}</strong></p>
    <Content />
    <hr />
    <p>
      Source: <a href={post.data.source_url} rel="noopener" target="_blank">PMID {post.data.pmid}</a>
      {post.data.journal && <span> ({post.data.journal}{post.data.year && `, ${post.data.year}`})</span>}
    </p>
    {post.data.affiliate_links && post.data.affiliate_links.length > 0 && (
      <section>
        <h2>Related books #PR</h2>
        <ul>
          {post.data.affiliate_links.map((l) => (
            <li><a href={l.url} rel="sponsored noopener" target="_blank">{l.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="related-section">
      <h2>More psychology trivia</h2>
      <ul class="card-grid">
        {related.map((p) => (
          <li class="card">
            <a href={`/en/psychology/${p.id}/`}>{p.data.title}</a>
            <p class="card__fact">{p.data.fact}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
