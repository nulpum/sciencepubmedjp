---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('en_psychology')).sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);

export const prerender = true;
---
<BaseLayout
  title="Psychology Trivia ｜ PubMed Trivia"
  description="Trivia from psychology, sleep, memory, and decision-making research on PubMed."
  lang="en"
>
  <h1>Psychology Trivia</h1>
  <p>Bite-sized trivia from psychology, sleep, memory, and behavioral research.</p>
  <ul class="card-grid">
    {posts.map((post) => (
      <li class="card">
        <a href={`/en/psychology/${post.id}/`}>{post.data.title}</a>
        <p class="card__fact">{post.data.fact}</p>
        <div class="card__meta">
          <span class="tag tag--psychology">Psychology</span>
          {post.data.journal && <span>{post.data.journal}{post.data.year && ` · ${post.data.year}`}</span>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
