---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('en_biology')).sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);
---
<BaseLayout title="Biology Trivia | PubMed Trivia" lang="en">
  <h1>Biology Trivia</h1>
  <ul>
    {posts.map((post) => (
      <li><a href={`/en/biology/${post.id}/`}>{post.data.title}</a></li>
    ))}
  </ul>
</BaseLayout>
