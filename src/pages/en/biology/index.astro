---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('en_biology')).sort(
  (a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at),
);

export const prerender = true;
---
<BaseLayout
  title="Biology Trivia ｜ PubMed Trivia"
  description="Trivia from animal behavior, evolution, ecology, and anthropology research on PubMed."
  lang="en"
>
  <h1>Biology Trivia</h1>
  <p>Bite-sized trivia from animal behavior, evolution, ecology, and anthropology research.</p>
  <ul class="card-grid">
    {posts.map((post) => (
      <li class="card">
        <a href={`/en/biology/${post.id}/`}>{post.data.title}</a>
        <p class="card__fact">{post.data.fact}</p>
        <div class="card__meta">
          <span class="tag tag--biology">Biology</span>
          {post.data.journal && <span>{post.data.journal}{post.data.year && ` · ${post.data.year}`}</span>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
