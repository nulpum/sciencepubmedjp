---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('en_biology');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);

const related = (all as typeof post[])
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Date.parse(b.data.generated_at) - Date.parse(a.data.generated_at))
  .slice(0, 3);

const ogImage = `/og/en/${post.id}.png`;
const tocItems = headings.filter((h) => h.depth === 2);

const siteUrl = 'https://sciencepubmed.net';
const articleUrl = `${siteUrl}/en/biology/${post.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': post.data.title,
  'description': post.data.fact,
  'datePublished': post.data.generated_at,
  'dateModified': post.data.generated_at,
  'author': { '@type': 'Organization', 'name': 'PubMed Trivia Editorial', 'url': siteUrl },
  'publisher': {
    '@type': 'Organization', 'name': 'PubMed Trivia',
    'logo': { '@type': 'ImageObject', 'url': `${siteUrl}/profile.png` },
  },
  'image': `${siteUrl}${ogImage}`,
  'mainEntityOfPage': articleUrl,
  'citation': post.data.source_url,
  'isAccessibleForFree': true,
  'inLanguage': 'en-US',
  'about': { '@type': 'Thing', 'name': 'Biology' },
};

export const prerender = true;
---
<BaseLayout title={post.data.title} description={post.data.fact} lang="en" ogType="article" ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="article">
    <header class="article__header">
      <p class="article__breadcrumb">
        <a href="/en/">Home</a> › <a href="/en/biology/">Biology</a>
      </p>
      <h1>{post.data.title}</h1>
      <p class="article__fact"><strong>{post.data.fact}</strong></p>
    </header>

    {tocItems.length >= 2 && (
      <nav class="article__toc" aria-label="Table of contents">
        <p class="article__toc-title">In this article</p>
        <ol>
          {tocItems.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    {post.data.affiliate_links && post.data.affiliate_links.length > 0 && (
      <aside class="article__cta article__cta--top">
        <p class="article__cta-label">📖 Want to dive deeper?</p>
        <p class="article__cta-body">
          Related books on this topic (Amazon):
          <a href={post.data.affiliate_links[0].url} rel="sponsored noopener" target="_blank">
            {post.data.affiliate_links[0].title} →
          </a>
        </p>
        <p class="article__cta-note">#PR / Amazon Associates</p>
      </aside>
    )}

    <div class="article__body">
      <Content />
    </div>

    {post.data.affiliate_links && post.data.affiliate_links.length > 0 && (
      <aside class="article__cta article__cta--bottom">
        <p class="article__cta-label">🔍 Explore further</p>
        <p class="article__cta-body">
          For deeper reading on this research area, check out these related books:
        </p>
        <ul class="article__cta-links">
          {post.data.affiliate_links.map((l) => (
            <li>
              <a href={l.url} rel="sponsored noopener" target="_blank">
                📚 {l.title}
              </a>
            </li>
          ))}
        </ul>
        <p class="article__cta-note">
          #PR / This site is an Amazon Associates participant. Purchases via these links may earn us a small commission (at no extra cost to you).
        </p>
      </aside>
    )}

    <hr />

    <section class="article__source">
      <h2>Source</h2>
      <ul>
        <li><strong>PMID</strong>: <a href={post.data.source_url} rel="noopener" target="_blank">{post.data.pmid}</a> (read full paper on PubMed)</li>
        {post.data.journal && <li><strong>Journal</strong>: {post.data.journal}{post.data.year && ` (${post.data.year})`}</li>}
      </ul>
      <p class="article__disclaimer">
        Articles on this site are adapted from PubMed abstracts as general-interest explainers.
        They are not intended as medical advice.
      </p>
    </section>

    {/* Old related books section removed, replaced by top/bottom CTA asides */}
  </article>

  {related.length > 0 && (
    <section class="related-section">
      <h2>More biology trivia</h2>
      <ul class="card-grid">
        {related.map((p) => (
          <li class="card">
            <a href={`/en/biology/${p.id}/`}>{p.data.title}</a>
            <p class="card__fact">{p.data.fact}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <style>
    .article { max-width: 760px; margin: 0 auto; padding: 24px 20px; }
    .article__breadcrumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 8px; }
    .article__breadcrumb a { color: var(--muted); }
    .article__header h1 { font-size: 1.8rem; line-height: 1.4; margin: 8px 0 16px; color: var(--navy); }
    .article__fact { background: var(--fact-bg); padding: 14px 18px; border-radius: 8px; line-height: 1.6; }
    .article__toc { background: #f7f9fc; border-left: 4px solid var(--navy); padding: 14px 18px 14px 22px; margin: 28px 0; border-radius: 4px; }
    .article__toc-title { font-weight: 700; color: var(--navy); margin: 0 0 8px; }
    .article__toc ol { margin: 0; padding-left: 20px; line-height: 1.85; }
    .article__toc a { color: var(--link); }
    .article__body :global(h2) { font-size: 1.25rem; color: var(--navy); margin-top: 30px; padding-left: 10px; border-left: 4px solid var(--navy); scroll-margin-top: 16px; }
    .article__body :global(p) { line-height: 1.9; margin: 14px 0; }
    .article__source { background: #fafafa; padding: 16px 20px; border-radius: 8px; margin: 28px 0; }
    .article__source h2 { font-size: 1.1rem; margin-top: 0; color: var(--navy); }
    .article__source ul { margin: 8px 0; padding-left: 22px; }
    .article__disclaimer { font-size: 0.85rem; color: var(--muted); margin-top: 12px; }
    .article__cta { margin: 24px 0; padding: 16px 18px; background: linear-gradient(180deg, #fff8ea 0%, #fef4d8 100%); border: 1px solid #f0d78a; border-radius: 8px; }
    .article__cta--top { margin: 20px 0 28px; }
    .article__cta--bottom { margin: 32px 0 24px; }
    .article__cta-label { font-weight: 700; color: #7a5a1e; margin: 0 0 6px; font-size: 0.95rem; }
    .article__cta-body { margin: 4px 0 8px; line-height: 1.65; color: var(--text); }
    .article__cta-body a { color: #a05e00; font-weight: 600; text-decoration: none; border-bottom: 2px solid #f0d78a; }
    .article__cta-body a:hover { border-bottom-color: #a05e00; }
    .article__cta-links { margin: 6px 0 8px; padding-left: 4px; list-style: none; }
    .article__cta-links li { margin: 6px 0; }
    .article__cta-links a { display: inline-block; color: #a05e00; font-weight: 500; text-decoration: none; padding: 4px 0; border-bottom: 1px dashed #d4b168; }
    .article__cta-links a:hover { border-bottom-style: solid; }
    .article__cta-note { font-size: 0.75rem; color: #8a7448; margin: 8px 0 0; }
  </style>
</BaseLayout>
