---
import MoshimoBanner from '../components/MoshimoBanner.astro';

interface Props {
  title: string;
  description?: string;
  lang: 'ja' | 'en';
  ogImage?: string;   // 個別記事ページが任意で上書き可
  ogType?: 'website' | 'article';
}
const {
  title,
  description = '',
  lang,
  ogImage = '/profile.png',
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const absoluteOg = ogImage.startsWith('http')
  ? ogImage
  : `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;
const siteName = lang === 'ja' ? 'PubMed Trivia' : 'PubMed Trivia';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/profile.png" />
    {/* CWV 対策: 主要外部ホストへ preconnect / dns-prefetch (2026-09-21 追加) */}
    <link rel="preconnect" href="https://image.moshimo.com" crossorigin />
    <link rel="preconnect" href="https://af.moshimo.com" crossorigin />
    <link rel="preconnect" href="https://i.moshimo.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://widget.rakuten.co.jp" />

    <title>{title}</title>

    {/* === Open Graph (Facebook / Threads / LINE 等) === */}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    {/* === Twitter / X Card === */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    {/* Google AdSense (審査・配信用) */}
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1702094040387118"
      crossorigin="anonymous"
    ></script>

    {/* Google Analytics 4 (GA4) - 測定 ID: G-PNYCBNKVL9 */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PNYCBNKVL9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PNYCBNKVL9');
    </script>

    {/* Global Moshimo click tracker (2026-09-21 追加)
        目的: MoshimoBanner の slot-scoped tracker が捕捉できない
        Rakuten CTA / モーションウィジェット / chip などの クリックも 拾い、
        Moshimo dashboard の click 数と GA4 の 数字を 一致させる。
        source 別に集計できるようにする。 */}
    <script is:inline>
      (function () {
        if (window.__moshimoGlobalClickInit) return;
        window.__moshimoGlobalClickInit = true;
        function classify(link) {
          if (link.closest('[data-moshimo-slot]')) return 'banner';
          if (link.closest('.aff-cta__chip')) return 'chip';
          if (link.classList && link.classList.contains('aff-cta__btn')) return 'cta_button';
          if (link.closest('.rakuten-motion') || link.closest('[data-rakuten-widget]')) return 'motion_widget';
          if (link.closest('.sticky-mobile-cta')) return 'sticky_mobile';
          return 'other';
        }
        document.addEventListener('click', function (ev) {
          var link = ev.target && ev.target.closest ? ev.target.closest('a') : null;
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (href.indexOf('af.moshimo.com') < 0 && href.indexOf('moshimo.com') < 0) return;
          if (typeof gtag !== 'function') return;
          try {
            gtag('event', 'moshimo_link_click', {
              source: classify(link),
              link_url: href.slice(0, 200),
              page_path: location.pathname,
              transport_type: 'beacon',
            });
          } catch (e) {}
        }, { capture: true, passive: true });
      })();
    </script>

    {/* Google Search Console 認証メタタグ (GA4 経由認証を使う場合は不要、
        HTML タグ認証なら content="..." の値を Search Console 側でコピペ確認用に埋める) */}
    {/* <meta name="google-site-verification" content="ここに認証文字列を入れる" /> */}
    {/* サイト全体の Organization JSON-LD (E-E-A-T 向け publisher 情報) */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PubMed Trivia",
      "url": "https://sciencepubmed.net",
      "logo": "https://sciencepubmed.net/profile.png",
      "description": lang === 'ja'
        ? "PubMed の 査読付き論文を 一般読者向けに 翻案する 科学トリビアサイト。編集方針は https://sciencepubmed.net/ja/editorial-policy/ に開示。"
        : "A science trivia site adapting peer-reviewed PubMed papers for general readers. Editorial policy: https://sciencepubmed.net/en/editorial-policy/",
      "sameAs": [
        "https://x.com/science_pubmed",
        "https://www.threads.com/@science_pubmed",
        "https://www.instagram.com/science_pubmed/",
        "https://zenn.dev/sciencepubmed"
      ],
      "email": "sciencepubmedjp@gmail.com",
      "foundingDate": "2026-05"
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={`/${lang}/`}>PubMed Trivia</a>
        <nav class="site-nav">
          <a href={`/${lang}/psychology/`}>Psychology</a>
          <a href={`/${lang}/biology/`}>Biology</a>
          <a href={`/${lang}/search/`}>🔍</a>
          <a href={`/${lang}/archive/`}>📅</a>
          <a href={`/${lang}/tag/`}>🏷️</a>
          {lang === 'ja' && (
            <>
              <a href="/ja/hub/">📚</a>
              <a href="/ja/lab/" class="site-nav__cta">🔬 Lab</a>
            </>
          )}
          <span class="site-nav__sep" aria-hidden="true">|</span>
          <a href="/ja/" class={lang === 'ja' ? 'is-active' : ''}>JA</a>
          <span class="site-nav__sep" aria-hidden="true">/</span>
          <a href="/en/" class={lang === 'en' ? 'is-active' : ''}>EN</a>
        </nav>
      </div>
    </header>

    {/* ヘッダー下のグローバルバナー (全ページ、JA のみ) */}
    {lang === 'ja' && (
      <div class="global-banner">
        <MoshimoBanner />
      </div>
    )}

    <div class="site-shell">
      <main class="site-main">
        <slot />
      </main>
      {lang === 'ja' && (
        <aside class="site-sidebar" aria-label="スポンサー広告">
          <MoshimoBanner />
        </aside>
      )}
    </div>
    <footer class="site-footer">
      <nav class="site-footer__nav">
        <a href={`/${lang}/about/`}>{lang === 'ja' ? 'このサイトについて' : 'About'}</a>
        <span aria-hidden="true">·</span>
        <a href={`/${lang}/privacy/`}>{lang === 'ja' ? 'プライバシーポリシー' : 'Privacy Policy'}</a>
        {lang === 'ja' && (
          <>
            <span aria-hidden="true">·</span>
            <a href="/ja/lab/">🔬 PubMed Lab</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/guide/how-to-read-research/">論文の読み方</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/guide/glossary/">研究用語集</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/guide/faq/">FAQ</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/guide/pubmed-search-guide/">🔍 PubMed 検索</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/guide/paper-critique/">✔️ 論文批判的読み方</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/hub/">📚 ハブ</a>
            <span aria-hidden="true">·</span>
            <a href="/ja/editorial-policy/">📝 編集方針</a>
          </>
        )}
        <span aria-hidden="true">·</span>
        <a href="https://x.com/science_pubmed" rel="me noopener" target="_blank">X</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.threads.com/@science_pubmed" rel="me noopener" target="_blank">Threads</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.instagram.com/science_pubmed/" rel="me noopener" target="_blank">Instagram</a>
      </nav>
      <small>{lang === 'ja' ? '本サイトには広告 (#PR) を含みます。' : 'This site contains advertising and affiliate links (#PR).'}</small>
    </footer>

    <style is:global>
      /* === Design tokens === */
      :root {
        --navy: #1a365d;
        --navy-deep: #142a4a;
        --link: #2c5282;
        --link-hover: #1a365d;
        --text: #1a202c;
        --muted: #718096;
        --border: #e2e8f0;
        --bg: #fafafa;
        --card: #ffffff;
        --fact-bg: #f0f4fa;
        --tag-psy: #e6f0ff;
        --tag-psy-text: #1e40af;
        --tag-bio: #e6f7ed;
        --tag-bio-text: #166534;
      }

      /* === Reset / base === */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family:
          system-ui, -apple-system, "Segoe UI", "Hiragino Sans",
          "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
        line-height: 1.75;
        color: var(--text);
        background: var(--bg);
      }
      a { color: var(--link); text-decoration: none; }
      a:hover { color: var(--link-hover); text-decoration: underline; }
      img { max-width: 100%; height: auto; }

      /* === Header === */
      .site-header {
        background: var(--card);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header__inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .site-brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--navy);
        letter-spacing: 0.01em;
      }
      .site-brand:hover { text-decoration: none; color: var(--navy-deep); }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.92rem;
      }
      .site-nav a { color: var(--muted); }
      .site-nav a:hover { color: var(--navy); text-decoration: none; }
      .site-nav a.is-active { color: var(--navy); font-weight: 600; }
      .site-nav__sep { color: var(--border); }
      /* Lab リンクは目立たせる (背景付きボタン風) */
      .site-nav__cta {
        background: var(--navy);
        color: white !important;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
      }
      .site-nav__cta:hover {
        background: var(--navy-deep);
        color: white !important;
      }

      /* === Global banner (ヘッダー下、全ページ) === */
      .global-banner {
        max-width: 960px;
        margin: 12px auto 0;
        padding: 0 20px;
      }

      /* === Site shell (main + sidebar のラッパー) === */
      .site-shell {
        max-width: 960px;
        margin: 0 auto;
      }
      .site-sidebar {
        display: none;
      }

      /* PC (≥ 1280px) で サイドバー 表示、grid レイアウト */
      @media (min-width: 1280px) {
        .site-shell {
          max-width: 1280px;
          display: grid;
          grid-template-columns: 1fr 300px;
          gap: 32px;
          padding: 0 20px;
          align-items: start;
        }
        .site-shell .site-main {
          max-width: none;
          margin: 0;
          padding-left: 0;
          padding-right: 0;
        }
        .site-sidebar {
          display: block;
          position: sticky;
          top: 76px;
          align-self: start;
        }
      }

      /* === Main === */
      .site-main {
        max-width: 960px;
        margin: 0 auto;
        padding: 32px 20px 48px;
      }
      .site-main h1 {
        font-size: 1.7rem;
        line-height: 1.4;
        color: var(--navy);
        margin: 0 0 18px;
      }
      .site-main h2 {
        font-size: 1.15rem;
        color: var(--navy);
        margin: 32px 0 12px;
      }
      .site-main p { margin: 0 0 16px; }

      /* article ページのみ本文幅を狭く */
      .site-main article {
        max-width: 720px;
        margin: 0 auto;
      }

      /* 関連記事セクション (記事下) — カードグリッドのまま、最大幅を本文より広めに */
      .site-main .related-section {
        max-width: 960px;
        margin: 48px auto 0;
        background: transparent;
        border: none;
        padding: 0;
      }
      .site-main .related-section h2 {
        font-size: 1rem;
        color: var(--muted);
        letter-spacing: 0.04em;
        margin: 0 0 16px;
      }

      /* article-level: fact (1 文目) を強調 */
      .site-main article > p:first-of-type strong,
      .site-main article > p strong:first-child {
        display: inline;
      }
      .site-main article > p:first-of-type {
        background: var(--fact-bg);
        border-left: 4px solid var(--navy);
        padding: 14px 16px;
        border-radius: 0 6px 6px 0;
        margin: 0 0 24px;
        font-size: 1.02rem;
      }
      .site-main article > p:first-of-type strong {
        font-weight: 600;
        color: var(--navy-deep);
      }

      /* hr */
      .site-main hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 28px 0;
      }

      /* affiliate section */
      .site-main section {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 18px 20px;
        border-radius: 8px;
        margin-top: 24px;
      }
      .site-main section h2 {
        margin-top: 0;
        font-size: 1rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }
      .site-main section ul {
        margin: 0;
        padding-left: 20px;
      }
      .site-main section li { margin: 6px 0; }

      /* === Card grid (top / category index) === */
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        margin: 24px 0;
        list-style: none;
        padding: 0;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(26, 54, 93, 0.08);
      }
      .card a {
        color: var(--navy);
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.45;
      }
      .card a:hover {
        text-decoration: none;
        color: var(--navy-deep);
      }
      .card__fact {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card__meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
        color: var(--muted);
        margin-top: auto;
      }
      .tag {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .tag--psychology { background: var(--tag-psy); color: var(--tag-psy-text); }
      .tag--biology   { background: var(--tag-bio); color: var(--tag-bio-text); }

      /* legacy ul listing (fallback) */
      .site-main > ul:not(.card-grid) {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .site-main > ul:not(.card-grid) li {
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }
      .site-main > ul:not(.card-grid) li:last-child { border-bottom: 0; }

      /* === Share section (article end) === */
      .site-main .share-section {
        max-width: 720px;
        margin: 32px auto 0;
        padding: 20px;
        background: transparent;
        border: 1px dashed var(--border);
        border-radius: 8px;
        text-align: center;
      }

      /* === Footer === */
      .site-footer {
        max-width: 960px;
        margin: 32px auto 0;
        padding: 20px;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--muted);
      }
      .site-footer small { font-size: 0.82rem; }
      .site-footer__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 0.88rem;
      }
      .site-footer__nav a { color: var(--muted); }
      .site-footer__nav a:hover { color: var(--navy); }
      .site-footer__nav span { color: var(--border); }

      /* === Responsive === */
      @media (max-width: 480px) {
        .site-main h1 { font-size: 1.4rem; }
        .site-header__inner { padding: 12px 16px; }
        .site-main { padding: 24px 16px 36px; }
        .card-grid { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
