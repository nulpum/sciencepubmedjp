---
interface Props {
  title: string;
  description?: string;
  lang: 'ja' | 'en';
}
const { title, description = '', lang } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {/* Phase 2: AdSense / GA タグはここに差し込む */}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={`/${lang}/`}>PubMed Trivia</a>
        <nav class="site-nav">
          <a href={`/${lang}/psychology/`}>Psychology</a>
          <a href={`/${lang}/biology/`}>Biology</a>
          <span class="site-nav__sep" aria-hidden="true">|</span>
          <a href="/ja/" class={lang === 'ja' ? 'is-active' : ''}>JA</a>
          <span class="site-nav__sep" aria-hidden="true">/</span>
          <a href="/en/" class={lang === 'en' ? 'is-active' : ''}>EN</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <small>本サイトには広告 (#PR) を含みます。</small>
    </footer>

    <style is:global>
      /* === Design tokens === */
      :root {
        --navy: #1a365d;
        --navy-deep: #142a4a;
        --link: #2c5282;
        --link-hover: #1a365d;
        --text: #1a202c;
        --muted: #718096;
        --border: #e2e8f0;
        --bg: #fafafa;
        --card: #ffffff;
        --fact-bg: #f0f4fa;
      }

      /* === Reset / base === */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family:
          system-ui, -apple-system, "Segoe UI", "Hiragino Sans",
          "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
        line-height: 1.75;
        color: var(--text);
        background: var(--bg);
      }
      a { color: var(--link); text-decoration: none; }
      a:hover { color: var(--link-hover); text-decoration: underline; }
      img { max-width: 100%; height: auto; }

      /* === Header === */
      .site-header {
        background: var(--card);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header__inner {
        max-width: 760px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .site-brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--navy);
        letter-spacing: 0.01em;
      }
      .site-brand:hover { text-decoration: none; color: var(--navy-deep); }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.92rem;
      }
      .site-nav a { color: var(--muted); }
      .site-nav a:hover { color: var(--navy); text-decoration: none; }
      .site-nav a.is-active { color: var(--navy); font-weight: 600; }
      .site-nav__sep { color: var(--border); }

      /* === Main === */
      .site-main {
        max-width: 720px;
        margin: 0 auto;
        padding: 32px 20px 48px;
      }
      .site-main h1 {
        font-size: 1.7rem;
        line-height: 1.4;
        color: var(--navy);
        margin: 0 0 18px;
      }
      .site-main h2 {
        font-size: 1.15rem;
        color: var(--navy);
        margin: 32px 0 12px;
      }
      .site-main p { margin: 0 0 16px; }

      /* article-level: fact (1 文目) を強調 */
      .site-main article > p:first-of-type strong,
      .site-main article > p strong:first-child {
        display: inline;
      }
      .site-main article > p:first-of-type {
        background: var(--fact-bg);
        border-left: 4px solid var(--navy);
        padding: 14px 16px;
        border-radius: 0 6px 6px 0;
        margin: 0 0 24px;
        font-size: 1.02rem;
      }
      .site-main article > p:first-of-type strong {
        font-weight: 600;
        color: var(--navy-deep);
      }

      /* hr */
      .site-main hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 28px 0;
      }

      /* affiliate section */
      .site-main section {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 18px 20px;
        border-radius: 8px;
        margin-top: 24px;
      }
      .site-main section h2 {
        margin-top: 0;
        font-size: 1rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }
      .site-main section ul {
        margin: 0;
        padding-left: 20px;
      }
      .site-main section li { margin: 6px 0; }

      /* lists on category index pages */
      .site-main > ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .site-main > ul li {
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }
      .site-main > ul li:last-child { border-bottom: 0; }
      .site-main > ul li a {
        font-weight: 500;
        color: var(--navy);
      }
      .site-main > ul li small {
        color: var(--muted);
        margin-left: 6px;
      }

      /* === Footer === */
      .site-footer {
        max-width: 760px;
        margin: 32px auto 0;
        padding: 20px;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--muted);
      }
      .site-footer small { font-size: 0.82rem; }

      /* === Responsive === */
      @media (max-width: 480px) {
        .site-main h1 { font-size: 1.4rem; }
        .site-header__inner { padding: 12px 16px; }
        .site-main { padding: 24px 16px 36px; }
      }
    </style>
  </body>
</html>
