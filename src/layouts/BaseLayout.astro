---
interface Props {
  title: string;
  description?: string;
  lang: 'ja' | 'en';
  ogImage?: string;   // 個別記事ページが任意で上書き可
  ogType?: 'website' | 'article';
}
const {
  title,
  description = '',
  lang,
  ogImage = '/profile.png',
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const absoluteOg = ogImage.startsWith('http')
  ? ogImage
  : `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;
const siteName = lang === 'ja' ? 'PubMed Trivia' : 'PubMed Trivia';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/profile.png" />
    <title>{title}</title>

    {/* === Open Graph (Facebook / Threads / LINE 等) === */}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    {/* === Twitter / X Card === */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    {/* Phase 2: AdSense / GA タグはここに差し込む */}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={`/${lang}/`}>PubMed Trivia</a>
        <nav class="site-nav">
          <a href={`/${lang}/psychology/`}>Psychology</a>
          <a href={`/${lang}/biology/`}>Biology</a>
          <span class="site-nav__sep" aria-hidden="true">|</span>
          <a href="/ja/" class={lang === 'ja' ? 'is-active' : ''}>JA</a>
          <span class="site-nav__sep" aria-hidden="true">/</span>
          <a href="/en/" class={lang === 'en' ? 'is-active' : ''}>EN</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <nav class="site-footer__nav">
        <a href={`/${lang}/about/`}>{lang === 'ja' ? 'このサイトについて' : 'About'}</a>
        <span aria-hidden="true">·</span>
        <a href={`/${lang}/privacy/`}>{lang === 'ja' ? 'プライバシーポリシー' : 'Privacy Policy'}</a>
        <span aria-hidden="true">·</span>
        <a href="https://x.com/science_pubmed" rel="me noopener" target="_blank">X</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.threads.com/@science_pubmed" rel="me noopener" target="_blank">Threads</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.instagram.com/science_pubmed/" rel="me noopener" target="_blank">Instagram</a>
      </nav>
      <small>{lang === 'ja' ? '本サイトには広告 (#PR) を含みます。' : 'This site contains advertising and affiliate links (#PR).'}</small>
    </footer>

    <style is:global>
      /* === Design tokens === */
      :root {
        --navy: #1a365d;
        --navy-deep: #142a4a;
        --link: #2c5282;
        --link-hover: #1a365d;
        --text: #1a202c;
        --muted: #718096;
        --border: #e2e8f0;
        --bg: #fafafa;
        --card: #ffffff;
        --fact-bg: #f0f4fa;
        --tag-psy: #e6f0ff;
        --tag-psy-text: #1e40af;
        --tag-bio: #e6f7ed;
        --tag-bio-text: #166534;
      }

      /* === Reset / base === */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family:
          system-ui, -apple-system, "Segoe UI", "Hiragino Sans",
          "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
        line-height: 1.75;
        color: var(--text);
        background: var(--bg);
      }
      a { color: var(--link); text-decoration: none; }
      a:hover { color: var(--link-hover); text-decoration: underline; }
      img { max-width: 100%; height: auto; }

      /* === Header === */
      .site-header {
        background: var(--card);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header__inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .site-brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--navy);
        letter-spacing: 0.01em;
      }
      .site-brand:hover { text-decoration: none; color: var(--navy-deep); }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.92rem;
      }
      .site-nav a { color: var(--muted); }
      .site-nav a:hover { color: var(--navy); text-decoration: none; }
      .site-nav a.is-active { color: var(--navy); font-weight: 600; }
      .site-nav__sep { color: var(--border); }

      /* === Main === */
      .site-main {
        max-width: 960px;
        margin: 0 auto;
        padding: 32px 20px 48px;
      }
      .site-main h1 {
        font-size: 1.7rem;
        line-height: 1.4;
        color: var(--navy);
        margin: 0 0 18px;
      }
      .site-main h2 {
        font-size: 1.15rem;
        color: var(--navy);
        margin: 32px 0 12px;
      }
      .site-main p { margin: 0 0 16px; }

      /* article ページのみ本文幅を狭く */
      .site-main article {
        max-width: 720px;
        margin: 0 auto;
      }

      /* article-level: fact (1 文目) を強調 */
      .site-main article > p:first-of-type strong,
      .site-main article > p strong:first-child {
        display: inline;
      }
      .site-main article > p:first-of-type {
        background: var(--fact-bg);
        border-left: 4px solid var(--navy);
        padding: 14px 16px;
        border-radius: 0 6px 6px 0;
        margin: 0 0 24px;
        font-size: 1.02rem;
      }
      .site-main article > p:first-of-type strong {
        font-weight: 600;
        color: var(--navy-deep);
      }

      /* hr */
      .site-main hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 28px 0;
      }

      /* affiliate section */
      .site-main section {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 18px 20px;
        border-radius: 8px;
        margin-top: 24px;
      }
      .site-main section h2 {
        margin-top: 0;
        font-size: 1rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }
      .site-main section ul {
        margin: 0;
        padding-left: 20px;
      }
      .site-main section li { margin: 6px 0; }

      /* === Card grid (top / category index) === */
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        margin: 24px 0;
        list-style: none;
        padding: 0;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(26, 54, 93, 0.08);
      }
      .card a {
        color: var(--navy);
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.45;
      }
      .card a:hover {
        text-decoration: none;
        color: var(--navy-deep);
      }
      .card__fact {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card__meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
        color: var(--muted);
        margin-top: auto;
      }
      .tag {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .tag--psychology { background: var(--tag-psy); color: var(--tag-psy-text); }
      .tag--biology   { background: var(--tag-bio); color: var(--tag-bio-text); }

      /* legacy ul listing (fallback) */
      .site-main > ul:not(.card-grid) {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .site-main > ul:not(.card-grid) li {
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }
      .site-main > ul:not(.card-grid) li:last-child { border-bottom: 0; }

      /* === Footer === */
      .site-footer {
        max-width: 960px;
        margin: 32px auto 0;
        padding: 20px;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--muted);
      }
      .site-footer small { font-size: 0.82rem; }
      .site-footer__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 0.88rem;
      }
      .site-footer__nav a { color: var(--muted); }
      .site-footer__nav a:hover { color: var(--navy); }
      .site-footer__nav span { color: var(--border); }

      /* === Responsive === */
      @media (max-width: 480px) {
        .site-main h1 { font-size: 1.4rem; }
        .site-header__inner { padding: 12px 16px; }
        .site-main { padding: 24px 16px 36px; }
        .card-grid { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
