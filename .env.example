# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# PubMed E-utilities (etiquette: tool 名と連絡先 email を必ず入れる)
PUBMED_TOOL=pubmed-trivia
PUBMED_EMAIL=you@example.com
# 任意。あれば 10 req/sec、無ければ 3 req/sec
PUBMED_API_KEY=

# サイト URL (OGP / sitemap で使用)
SITE_URL=https://sciencepubmed.net

# Amazon Product Advertising API (Phase 2: 関連書籍自動選定)
# 取得方法: affiliate.amazon.co.jp → ツール → Product Advertising API → 認証情報を管理
# Secret Key は1度しか表示されないので確実にメモ
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=sciencepubmed-22

# Phase 3: X / Twitter API
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
