# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# PubMed E-utilities (etiquette: tool 名と連絡先 email を必ず入れる)
PUBMED_TOOL=pubmed-trivia
PUBMED_EMAIL=you@example.com
# 任意。あれば 10 req/sec、無ければ 3 req/sec
PUBMED_API_KEY=

# サイト URL (OGP / sitemap で使用)
SITE_URL=https://sciencepubmed.net

# Amazon Product Advertising API (Phase 2: 関連書籍自動選定)
# 取得方法: affiliate.amazon.co.jp → ツール → Product Advertising API → 認証情報を管理
# Secret Key は1度しか表示されないので確実にメモ
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=sciencepubmed-22

# Phase 3-a: Threads API (Meta 公式)
# 取得: developers.facebook.com → アプリ作成 → Threads API 製品追加
#       → User Token Generator で long-lived token (60日有効) を発行
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me

# Phase 3-c: Facebook Page (同じ Meta Developer アプリで OK)
# 取得: Graph API Explorer で User Token (権限: pages_manage_posts,
#       pages_read_engagement, pages_show_list) → /me/accounts で
#       Page Access Token を取得 → 60日長期化
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Phase 4-A: Instagram Graph API (IG Business + FB Page 連携が前提)
# 取得手順:
#   1. IG アプリで @science_pubmed を Business アカウントに変換 + FB Page (PubMed Trivia) と連携
#   2. Meta Developer App に "Instagram" 製品を追加
#   3. Graph API Explorer で /{page_id}?fields=instagram_business_account → id を控える
#   4. FB Page Access Token の権限に instagram_basic / instagram_content_publish を追加
#      (または同じトークンを流用、scope に上記が含まれていれば OK)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Phase 3-b: X / Twitter API (将来、自動投稿用)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Phase 3-d: Gmail SMTP (X 投稿テンプレを自分の Gmail に通知)
# 取得: myaccount.google.com → セキュリティ → 2段階認証 ON
#       → アプリパスワード → "メール" 用に発行 (16 桁)
GMAIL_USER=sciencepubmedjp@gmail.com
GMAIL_APP_PASSWORD=
# 通知先 (未設定なら GMAIL_USER 自身宛て)
NOTIFY_EMAIL_TO=
